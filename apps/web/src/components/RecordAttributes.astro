<!--
<MODULE_CONTRACT>
<purpose>Renders a canonical record's custom attributes in a key-value table, skipping well-known fields handled by other components.</purpose>
<non-goals>
  <item>Does not render claims, evidence, or relations — attributes table only.</item>
</non-goals>
</MODULE_CONTRACT>
<CHANGE_SUMMARY>
  <item>Initial creation: RecordAttributes component with nested object formatting and skip-key filtering.</item>
</CHANGE_SUMMARY>
-->
---
import type { CanonicalRecord } from "@roguelike-games-ib/materializer";

interface Props {
  record: CanonicalRecord;
}

const { record } = Astro.props;

const SKIP_KEYS = new Set([
  "id", "key", "record_type", "schema", "language", "aliases",
  "epistemic", "evidence_refs", "claim_refs", "participant_refs",
  "origin", "scope", "source_identity", "activation",
]);

function formatValue(value: unknown): string {
  if (value === null) return "null";
  if (typeof value === "boolean") return value ? "true" : "false";
  if (typeof value === "number") return String(value);
  if (typeof value === "string") return value;
  if (Array.isArray(value)) return value.length === 0 ? "[]" : value.map(formatValue).join(", ");
  if (typeof value === "object") return JSON.stringify(value, null, 2);
  return String(value);
}

function isObject(value: unknown): value is Record<string, unknown> {
  return typeof value === "object" && value !== null && !Array.isArray(value);
}

const entries = Object.entries(record as Record<string, unknown>)
  .filter(([k]) => !SKIP_KEYS.has(k));
---

{entries.length > 0 && (
  <section>
    <h2 class="mb-3 text-lg font-semibold text-ib-text">Attributes</h2>
    <div class="overflow-hidden rounded-xl border border-ib-border bg-ib-surface">
      <table class="w-full text-sm">
        <tbody>
          {entries.map(([key, value], i) => (
            <tr class={i % 2 === 0 ? "bg-ib-surface2/50" : ""}>
              <td class="w-1/3 px-4 py-2 font-mono text-xs text-ib-muted align-top">{key}</td>
              <td class="px-4 py-2 text-ib-text align-top">
                {isObject(value) ? (
                  <table class="w-full text-xs">
                    <tbody>
                      {Object.entries(value).map(([subKey, subVal]) => (
                        <tr>
                          <td class="py-0.5 pr-3 font-mono text-ib-muted align-top">{subKey}</td>
                          <td class="py-0.5 text-ib-text align-top">{formatValue(subVal)}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                ) : (
                  <span class="whitespace-pre-wrap">{formatValue(value)}</span>
                )}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>
)}
