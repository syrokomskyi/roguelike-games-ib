<!--
<MODULE_CONTRACT>
<purpose>Renders a coverage dimensions table showing extraction state, expected, extracted, and validated counts per dimension.</purpose>
<non-goals>
  <item>Does not compute coverage — rendering of provided coverage records only.</item>
</non-goals>
</MODULE_CONTRACT>
<CHANGE_SUMMARY>
  <item>Initial creation: CoveragePanel component with dimension state badges and counts.</item>
</CHANGE_SUMMARY>
-->
---
import type { CoverageRecord } from "@roguelike-games-ib/knowledge-core";

interface Props {
  coverage: CoverageRecord[];
}

const { coverage } = Astro.props;
const dimensions = coverage.flatMap((c) => c.dimensions);
---

<div class="overflow-x-auto rounded-lg border border-ib-border">
  <table class="w-full border-collapse text-sm">
    <thead>
      <tr class="bg-ib-surface2 text-ib-muted">
        <th class="px-3 py-2 text-left">Dimension</th>
        <th class="px-3 py-2 text-left">State</th>
        <th class="px-3 py-2 text-right">Expected</th>
        <th class="px-3 py-2 text-right">Extracted</th>
        <th class="px-3 py-2 text-right">Validated</th>
      </tr>
    </thead>
    <tbody>
      {dimensions.map((d) => (
        <tr class="border-t border-ib-border">
          <td class="px-3 py-2 font-mono text-xs text-ib-text">{d.id}</td>
          <td class="px-3 py-2"><span class={`rounded-md px-2 py-0.5 text-xs ${d.state === "exhaustive_for_binding" ? "bg-ib-green/15 text-ib-green" : d.state === "substantially_covered" ? "bg-ib-blue/15 text-ib-blue" : d.state === "partial" ? "bg-ib-amber/15 text-ib-amber" : d.state === "blocked" ? "bg-ib-red/15 text-ib-red" : "bg-ib-surface2 text-ib-muted"}`}>{d.state}</span></td>
          <td class="px-3 py-2 text-right text-ib-muted">{d.expected ?? "—"}</td>
          <td class="px-3 py-2 text-right text-ib-muted">{d.extracted ?? "—"}</td>
          <td class="px-3 py-2 text-right text-ib-muted">{d.validated ?? "—"}</td>
        </tr>
      ))}
      {dimensions.length === 0 && (
        <tr class="border-t border-ib-border"><td colspan="5" class="px-3 py-4 text-center text-ib-muted">No coverage data yet.</td></tr>
      )}
    </tbody>
  </table>
</div>
