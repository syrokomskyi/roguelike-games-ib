---
interface Props {
  assertionState?: string;
  confidence?: string;
}

const { assertionState, confidence } = Astro.props;
---

<span class="inline-flex items-center gap-1 border border-ib-border px-2 py-1 font-mono text-[10px] font-medium uppercase tracking-wider text-ib-muted" data-assertion={assertionState ?? "unknown"}>
  {assertionState === "contested" ? "⚠ Contested" : assertionState === "supported" ? "✓ Supported" : "○ Unknown"}
  {confidence ? ` · ${confidence}` : ""}
</span>
