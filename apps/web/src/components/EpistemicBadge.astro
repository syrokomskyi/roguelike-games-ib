<!--
<MODULE_CONTRACT>
<purpose>Renders an inline epistemic status badge showing assertion state (contested, supported, unknown) and optional confidence.</purpose>
<non-goals>
  <item>Does not determine epistemic status — display component only.</item>
</non-goals>
</MODULE_CONTRACT>
<CHANGE_SUMMARY>
  <item>Initial creation: EpistemicBadge component with assertion state and confidence display.</item>
</CHANGE_SUMMARY>
-->
---
interface Props {
  assertionState?: string;
  confidence?: string;
}

const { assertionState, confidence } = Astro.props;
---

<span class="inline-flex items-center gap-1 rounded-full bg-ib-surface2 px-2.5 py-0.5 text-xs font-medium text-ib-muted" data-assertion={assertionState ?? "unknown"}>
  {assertionState === "contested" ? "⚠ Contested" : assertionState === "supported" ? "✓ Supported" : "○ Unknown"}
  {confidence ? ` · ${confidence}` : ""}
</span>
