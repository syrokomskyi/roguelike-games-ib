---
interface Props {
  assertionState?: string;
  confidence?: string;
}

const { assertionState, confidence } = Astro.props;
---

<span class="epistemic-badge" data-assertion={assertionState ?? "unknown"}>
  {assertionState === "contested" ? "Contested" : assertionState === "supported" ? "Supported" : "Unknown"}
  {confidence ? ` · ${confidence}` : ""}
</span>

<style>
.epistemic-badge {
  display: inline-block;
  padding: 2px 8px;
  border-radius: 4px;
  font-size: 0.75rem;
  background: #e2e3e5;
  color: #383d41;
}
</style>
