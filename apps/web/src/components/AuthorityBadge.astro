---
import type { Authority } from "../lib/authority";

interface Props {
  authority: Authority;
}

const { authority } = Astro.props;
---

<span class={`inline-flex items-center gap-1 border px-2 py-1 font-mono text-[10px] font-semibold uppercase tracking-wider ${authority === "canonical" ? "border-ib-green/40 text-ib-green" : "border-ib-accent2/50 text-ib-accent2"}`} data-authority={authority}>
  {authority === "canonical" ? "● Canonical" : "* Laboratory"}
</span>
