<!--
<MODULE_CONTRACT>
<purpose>Renders an inline badge indicating whether a record is canonical or laboratory authority in the web UI.</purpose>
<non-goals>
  <item>Does not enforce authority — display component only.</item>
</non-goals>
</MODULE_CONTRACT>
<CHANGE_SUMMARY>
  <item>Initial creation: AuthorityBadge component with canonical/laboratory styling.</item>
</CHANGE_SUMMARY>
-->
---
import { authorityBadge, type Authority } from "../lib/authority.ts";

interface Props {
  authority: Authority;
}

const { authority } = Astro.props;
const badge = authorityBadge(authority);
---

<span class={`inline-flex items-center gap-1 rounded-full px-2.5 py-0.5 text-xs font-semibold ${authority === "canonical" ? "bg-ib-green/15 text-ib-green" : "bg-ib-amber/15 text-ib-amber"}`} data-authority={authority}>
  {authority === "canonical" ? "✓ Canonical" : "⚠ Laboratory"}
</span>
