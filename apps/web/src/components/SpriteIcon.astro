---
import { spritePathToUrl, spriteExists } from "../lib/sprite";

interface Props {
  spritePath: string | null;
  sourceId: string;
  size?: number;
}

const { spritePath, sourceId, size = 24 } = Astro.props;
const url = spritePath ? spritePathToUrl(spritePath, sourceId) : "";
const hasSprite = spritePath ? spriteExists(spritePath, sourceId) : false;
---

<span class="shrink-0" style={`display:inline-block;height:${size}px;min-width:${size}px`}>
  {hasSprite && (
    <img
      src={url}
      alt=""
      loading="lazy"
      class="h-full w-auto"
    />
  )}
</span>
