---
import { keyToSpriteUrl, spriteExists } from "../lib/sprite";

interface Props {
  recordKey: string;
  size?: number;
}

const SPRITE_AR = 232 / 128;

const { recordKey, size = 24 } = Astro.props;
const url = keyToSpriteUrl(recordKey);
const hasSprite = spriteExists(recordKey);
const width = Math.round(size / SPRITE_AR);
---

<span class="shrink-0" style={`display:inline-block;width:${width}px;height:${size}px`}>
  {hasSprite && (
    <img
      src={url}
      alt=""
      loading="lazy"
      class="h-full w-full"
    />
  )}
</span>
