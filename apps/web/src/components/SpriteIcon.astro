---
import { keyToSpriteUrl } from "../lib/sprite";

interface Props {
  recordKey: string;
  size?: number;
}

const { recordKey, size = 24 } = Astro.props;
const url = keyToSpriteUrl(recordKey);
---

<img
  src={url}
  alt=""
  loading="lazy"
  class="shrink-0 object-contain"
  style={`width:${size}px;height:${size}px`}
  onerror="this.style.display='none'"
/>
