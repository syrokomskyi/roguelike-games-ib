---
import { keyToSpriteUrl, spriteExists } from "../lib/sprite";

interface Props {
  recordKey: string;
  size?: number;
}

const { recordKey, size = 24 } = Astro.props;
const url = keyToSpriteUrl(recordKey);
const hasSprite = spriteExists(recordKey);
---

<span class="shrink-0" style={`display:inline-block;height:${size}px;min-width:${size}px`}>
  {hasSprite && (
    <img
      src={url}
      alt=""
      loading="lazy"
      class="h-full w-auto"
    />
  )}
</span>
