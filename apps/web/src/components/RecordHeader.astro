---
import type { CanonicalRecord } from "@roguelike-games-ib/materializer";
import AuthorityBadge from "./AuthorityBadge.astro";
import EpistemicBadge from "./EpistemicBadge.astro";

interface Props {
  record: CanonicalRecord;
  authority?: "canonical" | "laboratory";
  assertionState?: string;
  canonicalHash?: string;
}

const { record, authority = "canonical", assertionState, canonicalHash } = Astro.props;
const title = (record as Record<string, unknown>)["title"] ?? record.key;
---

<div class="rounded-xl border border-ib-border bg-ib-surface p-6" data-record-id={record.id} data-record-key={record.key} data-canonical-hash={canonicalHash}>
  <h1 class="text-2xl font-bold text-ib-text">{title as string}</h1>
  <div class="mt-3 flex flex-wrap items-center gap-3 text-sm text-ib-muted">
    <span class="rounded-md bg-ib-surface2 px-2 py-1 font-mono text-xs">{record.key}</span>
    <span class="rounded-md bg-ib-accent/15 px-2 py-1 text-xs font-medium text-ib-accent">{record.record_type}</span>
    <AuthorityBadge authority={authority} />
    <EpistemicBadge assertionState={assertionState} />
  </div>
</div>
