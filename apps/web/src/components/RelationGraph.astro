---
import type { RelationRecord } from "@roguelike-games-ib/knowledge-core";
import { groupRelationsByType } from "@roguelike-games-ib/projection-sdk";

interface Props {
  relations: RelationRecord[];
  records: { id: string; key: string; record_type: string }[];
}

const { relations, records } = Astro.props;
const byType = groupRelationsByType(relations);
const recordMap = new Map(records.map((r) => [r.id, r]));
---

<div class="space-y-4">
  {[...byType.entries()].map(([type, rels]) => (
    <div class="rounded-lg border border-ib-border bg-ib-surface p-4">
      <h4 class="mb-2 text-sm font-semibold uppercase tracking-wide text-ib-accent2">{type}</h4>
      <div class="flex flex-col gap-2">
        {rels.map((rel) => {
          const source = recordMap.get(rel.source_record_id);
          const target = recordMap.get(rel.target_record_id);
          return (
            <div class="flex items-center gap-2 text-sm">
              <a href={`/records/${source?.key ?? rel.source_record_id}/`} class="rounded-md bg-ib-surface2 px-2 py-1 font-mono text-xs text-ib-text hover:text-ib-accent">{source?.key ?? rel.source_record_id}</a>
              <span class="text-ib-muted">→</span>
              <a href={`/records/${target?.key ?? rel.target_record_id}/`} class="rounded-md bg-ib-surface2 px-2 py-1 font-mono text-xs text-ib-text hover:text-ib-accent">{target?.key ?? rel.target_record_id}</a>
            </div>
          );
        })}
      </div>
    </div>
  ))}
  {relations.length === 0 && <p class="text-sm text-ib-muted">No relations found.</p>}
</div>
