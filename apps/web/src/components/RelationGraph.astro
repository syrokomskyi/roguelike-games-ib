---
import type { RelationRecord } from "@roguelike-games-ib/knowledge-core";
import { groupRelationsByType } from "@roguelike-games-ib/projection-sdk";
import SpriteIcon from "./SpriteIcon.astro";
import CollapsibleSection from "./CollapsibleSection.astro";

interface Props {
  relations: RelationRecord[];
  records: { id: string; key: string; record_type: string; sprite_path?: string | null; source_id?: string }[];
}

const { relations, records } = Astro.props;
const byType = groupRelationsByType(relations);
const recordMap = new Map(records.map((r) => [r.id, r]));
---

<div class="space-y-4">
  {[...byType.entries()].map(([type, rels]) => (
    <CollapsibleSection title={`${type} (${rels.length})`} open={type !== "PART_OF"}>
      <div class="flex flex-col gap-2">
        {rels.map((rel) => {
          const source = recordMap.get(rel.source_record_id);
          const target = recordMap.get(rel.target_record_id);
          return (
            <div class="flex items-center gap-2 text-sm">
              <SpriteIcon spritePath={source?.sprite_path ?? null} sourceId={source?.source_id ?? ""} size={20} />
              <a href={`/records/${source?.key ?? rel.source_record_id}/`} class="border-b border-ib-border py-1 font-mono text-xs text-ib-text hover:text-ib-accent">{source?.key ?? rel.source_record_id}</a>
              <span class="font-mono text-xs text-ib-blue">— {type} →</span>
              <SpriteIcon spritePath={target?.sprite_path ?? null} sourceId={target?.source_id ?? ""} size={20} />
              <a href={`/records/${target?.key ?? rel.target_record_id}/`} class="border-b border-ib-border py-1 font-mono text-xs text-ib-text hover:text-ib-accent">{target?.key ?? rel.target_record_id}</a>
            </div>
          );
        })}
      </div>
    </CollapsibleSection>
  ))}
  {relations.length === 0 && <p class="text-sm text-ib-muted">No relations found.</p>}
</div>
