---
interface Props {
  placeholder?: string;
}

const { placeholder = "Search records..." } = Astro.props;
---

<form class="search-box" action="/search" method="get">
  <input type="text" name="q" placeholder={placeholder} />
  <button type="submit">Search</button>
</form>

<style>
.search-box { display: flex; gap: 0.5rem; }
.search-box input { flex: 1; padding: 6px 10px; border: 1px solid #ccc; border-radius: 4px; }
.search-box button { padding: 6px 16px; border: 1px solid #ccc; border-radius: 4px; cursor: pointer; }
</style>
