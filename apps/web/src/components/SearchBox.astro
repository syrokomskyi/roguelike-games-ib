<!--
<MODULE_CONTRACT>
<purpose>Renders a search form with text input, optional source and record type hidden filters, and a submit button.</purpose>
<non-goals>
  <item>Does not execute search — form submission to /search endpoint only.</item>
</non-goals>
</MODULE_CONTRACT>
<CHANGE_SUMMARY>
  <item>Initial creation: SearchBox component with query input and filter hidden fields.</item>
</CHANGE_SUMMARY>
-->
---
interface Props {
  placeholder?: string;
  source?: string;
  recordType?: string;
}

const { placeholder = "Search records...", source, recordType } = Astro.props;
---

<form class="flex gap-2" action="/search" method="get">
  <input type="text" name="q" placeholder={placeholder} class="flex-1 rounded-lg border border-ib-border bg-ib-surface2 px-4 py-2 text-ib-text placeholder-ib-muted focus:border-ib-accent focus:outline-none" />
  {source && <input type="hidden" name="source" value={source} />}
  {recordType && <input type="hidden" name="type" value={recordType} />}
  <button type="submit" class="rounded-lg bg-ib-accent px-4 py-2 font-medium text-white hover:bg-ib-accent2">Search</button>
</form>
