---
interface Props {
  placeholder?: string;
  value?: string;
  source?: string;
  recordType?: string;
}

const { placeholder = "Search records...", value = "", source, recordType } = Astro.props;
---

<form class="flex gap-2" action="/search" method="get">
  <input type="text" name="q" value={value} placeholder={placeholder} class="flex-1 rounded-lg border border-ib-border bg-ib-surface2 px-4 py-2 text-ib-text placeholder-ib-muted focus:border-ib-accent focus:outline-none" />
  {source && <input type="hidden" name="source" value={source} />}
  {recordType && <input type="hidden" name="type" value={recordType} />}
  <button type="submit" class="rounded-lg bg-ib-accent px-4 py-2 font-medium text-white hover:bg-ib-accent2">Search</button>
</form>
