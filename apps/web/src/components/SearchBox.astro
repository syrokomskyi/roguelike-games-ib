---
interface Props {
  placeholder?: string;
}

const { placeholder = "Search records..." } = Astro.props;
---

<form class="flex gap-2" action="/search" method="get">
  <input type="text" name="q" placeholder={placeholder} class="flex-1 rounded-lg border border-ib-border bg-ib-surface2 px-4 py-2 text-ib-text placeholder-ib-muted focus:border-ib-accent focus:outline-none" />
  <button type="submit" class="rounded-lg bg-ib-accent px-4 py-2 font-medium text-white hover:bg-ib-accent2">Search</button>
</form>
