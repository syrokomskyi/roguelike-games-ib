---
import type { SourceBinding } from "@roguelike-games-ib/knowledge-core";
import CollapsibleSection from "./CollapsibleSection.astro";

interface Props {
  binding: SourceBinding;
}

const { binding } = Astro.props;
---

<CollapsibleSection title="Source Binding" open={false}>
  <dl class="grid grid-cols-[max-content_1fr] gap-x-4 gap-y-2 text-sm">
    <dt class="font-semibold text-ib-muted">Source ID</dt><dd class="text-ib-text">{binding.source_id}</dd>
    <dt class="font-semibold text-ib-muted">Version</dt><dd class="text-ib-text">{binding.declared_version}</dd>
    <dt class="font-semibold text-ib-muted">Fingerprint</dt><dd class="font-mono text-xs text-ib-text">{binding.fingerprint.algorithm}: {binding.fingerprint.value}</dd>
    <dt class="font-semibold text-ib-muted">Binding Digest</dt><dd class="font-mono text-xs text-ib-text">{binding.binding_digest}</dd>
    {binding.vcs && binding.vcs.repository && (
      <>
        <dt class="font-semibold text-ib-muted">VCS Repository</dt><dd><a href={binding.vcs.repository} class="text-ib-accent hover:text-ib-accent2">{binding.vcs.repository}</a></dd>
      </>
    )}
  </dl>
</CollapsibleSection>
