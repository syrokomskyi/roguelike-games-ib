---
import type { CompareRow } from "../lib/page-data";
import { keyToSpriteUrl } from "../lib/sprite";

interface Props {
  rows: CompareRow[];
}

const { rows } = Astro.props;
---

<div class="overflow-x-auto rounded-lg border border-ib-border">
  <table class="w-full border-collapse text-sm">
    <thead>
      <tr class="bg-ib-surface2 text-ib-muted">
        <th class="px-3 py-2 text-left">Key</th>
        <th class="px-3 py-2 text-left">Type</th>
        <th class="px-3 py-2 text-left">Title</th>
        <th class="px-3 py-2 text-center">Claims</th>
        <th class="px-3 py-2 text-center">Out</th>
        <th class="px-3 py-2 text-center">In</th>
      </tr>
    </thead>
    <tbody>
      {rows.map((row: CompareRow, i: number) => (
        <tr class={`border-t border-ib-border hover:bg-ib-surface2/50 ${i % 2 === 1 ? "bg-ib-surface2/30" : ""}`}>
          <td class="px-3 py-2">
            <div class="flex items-center gap-2">
              <img src={keyToSpriteUrl(row.record_key)} alt="" loading="lazy" class="h-6 w-6 shrink-0 object-cover" onerror="this.style.display='none'" />
              <a href={`/records/${row.record_key}/`} class="font-mono text-xs text-ib-accent hover:text-ib-accent2">{row.record_key}</a>
            </div>
          </td>
          <td class="px-3 py-2"><span class="rounded-md bg-ib-accent/15 px-2 py-0.5 text-xs text-ib-accent">{row.record_type}</span></td>
          <td class="px-3 py-2 text-ib-text">{row.title ?? "—"}</td>
          <td class="px-3 py-2 text-center text-ib-muted">{row.claim_count}</td>
          <td class="px-3 py-2 text-center text-ib-muted">{row.outgoing_relation_count}</td>
          <td class="px-3 py-2 text-center text-ib-muted">{row.incoming_relation_count}</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
