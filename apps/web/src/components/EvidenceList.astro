---
import type { RenderedEvidence } from "../lib/evidence";

interface Props {
  evidence: RenderedEvidence[];
}

const { evidence } = Astro.props;
---

<div class="space-y-3">
  {evidence.map((ev) => (
    <div class="border-l-2 border-ib-accent bg-ib-surface p-4" data-evidence-id={ev.id} data-restricted={ev.restricted} data-evidence-kind={ev.evidence_kind}>
      {ev.restricted ? (
        <p class="text-sm italic text-ib-amber">Evidence is not publicly accessible.</p>
      ) : ev.evidence_kind === "asset" && ev.media ? (
        <div class="space-y-2">
          <div class="flex items-center gap-2 text-xs text-ib-muted">
            <span class="rounded-md bg-ib-accent/15 px-1.5 py-0.5 text-ib-accent">asset</span>
            {ev.media.mime_type && <span class="font-mono">{ev.media.mime_type}</span>}
            {ev.media.width && ev.media.height && <span>{ev.media.width}×{ev.media.height}px</span>}
          </div>
          {ev.github_url ? (
            <div class="h-32 w-32 overflow-hidden rounded-lg border border-ib-border bg-ib-surface">
              <img src={ev.github_url} alt={ev.media.alt_text ?? ev.artifact_path ?? "image asset"} loading="lazy" class="h-full w-full object-cover" />
            </div>
          ) : (
            <p class="text-sm text-ib-muted">Image artifact not available for display.</p>
          )}
          {ev.artifact_path && (
            <p class="font-mono text-xs text-ib-muted">{ev.artifact_path}</p>
          )}
        </div>
      ) : (
        <div class="space-y-1">
          {ev.excerpt && <p class="font-mono text-sm whitespace-pre-wrap text-ib-text">{ev.excerpt}</p>}
          {ev.locator && (
            <p class="flex gap-3 text-xs text-ib-muted">
              {ev.locator.symbol && <span>Symbol: <code class="text-ib-accent2">{ev.locator.symbol}</code></span>}
              {ev.locator.line_start && (
                ev.github_url
                  ? <span>Lines: <a href={ev.github_url} target="_blank" rel="noopener noreferrer" class="text-ib-accent hover:text-ib-accent2">{ev.locator.line_start}–{ev.locator.line_end}</a></span>
                  : <span>Lines: {ev.locator.line_start}–{ev.locator.line_end}</span>
              )}
            </p>
          )}
          {ev.license_ref && <p class="text-xs text-ib-muted">License: {ev.license_ref}</p>}
        </div>
      )}
    </div>
  ))}
  {evidence.length === 0 && <p class="text-sm text-ib-muted">No public evidence available.</p>}
</div>
