---
import type { RenderedEvidence } from "../lib/evidence";

interface Props {
  evidence: RenderedEvidence[];
}

const { evidence } = Astro.props;
---

<div class="space-y-3">
  {evidence.map((ev) => (
    <div class="rounded-lg border-l-2 border-ib-border bg-ib-surface p-3" data-evidence-id={ev.id} data-restricted={ev.restricted}>
      {ev.restricted ? (
        <p class="text-sm italic text-ib-amber">Evidence is not publicly accessible.</p>
      ) : (
        <div class="space-y-1">
          {ev.excerpt && <p class="font-mono text-sm whitespace-pre-wrap text-ib-text">{ev.excerpt}</p>}
          {ev.locator && (
            <p class="flex gap-3 text-xs text-ib-muted">
              {ev.locator.symbol && <span>Symbol: <code class="text-ib-accent2">{ev.locator.symbol}</code></span>}
              {ev.locator.line_start && (
                ev.github_url
                  ? <span>Lines: <a href={ev.github_url} target="_blank" rel="noopener noreferrer" class="text-ib-accent hover:text-ib-accent2">{ev.locator.line_start}–{ev.locator.line_end}</a></span>
                  : <span>Lines: {ev.locator.line_start}–{ev.locator.line_end}</span>
              )}
            </p>
          )}
          {ev.license_ref && <p class="text-xs text-ib-muted">License: {ev.license_ref}</p>}
        </div>
      )}
    </div>
  ))}
  {evidence.length === 0 && <p class="text-sm text-ib-muted">No public evidence available.</p>}
</div>
