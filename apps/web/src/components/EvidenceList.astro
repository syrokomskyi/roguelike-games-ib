---
import type { RenderedEvidence } from "../lib/evidence.ts";

interface Props {
  evidence: RenderedEvidence[];
}

const { evidence } = Astro.props;
---

<ul class="evidence-list">
  {evidence.map((ev) => (
    <li class="evidence-item" data-evidence-id={ev.id} data-restricted={ev.restricted}>
      {ev.restricted ? (
        <p class="restricted-notice">Evidence is not publicly accessible.</p>
      ) : (
        <div>
          {ev.excerpt && <p class="excerpt">{ev.excerpt}</p>}
          {ev.locator && (
            <p class="locator">
              {ev.locator.symbol && <span>Symbol: {ev.locator.symbol}</span>}
              {ev.locator.line_start && <span>Lines: {ev.locator.line_start}–{ev.locator.line_end}</span>}
            </p>
          )}
          {ev.license_ref && <p class="license">License: {ev.license_ref}</p>}
        </div>
      )}
    </li>
  ))}
</ul>

<style>
.evidence-list { list-style: none; padding: 0; }
.evidence-item { margin-bottom: 1rem; padding: 0.5rem; border-left: 3px solid #ccc; }
.restricted-notice { color: #856404; font-style: italic; }
.excerpt { font-family: monospace; white-space: pre-wrap; }
</style>
