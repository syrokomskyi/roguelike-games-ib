---
import type { AncestryNode } from "../lib/page-data";
import { keyToSpriteUrl } from "../lib/sprite";

interface Props {
  ancestry: AncestryNode[];
}

const { ancestry } = Astro.props;
---

<div class="rounded-xl border border-ib-border bg-ib-surface p-5">
  <h3 class="mb-3 text-sm font-semibold uppercase tracking-wide text-ib-accent2">Ancestry</h3>
  <div class="space-y-1">
    {ancestry.map((node: AncestryNode) => (
      <div style={`margin-left: ${node.depth * 1.5}rem`} class="flex items-center gap-2 text-sm">
        <span class="text-ib-muted">{node.depth === 0 ? "●" : "└─"}</span>
        <img src={keyToSpriteUrl(node.record_key)} alt="" loading="lazy" class="h-5 w-5 shrink-0 object-contain" onerror="this.style.display='none'" />
        <a href={`/records/${node.record_key}/`} class="font-mono text-xs text-ib-accent hover:text-ib-accent2">{node.record_key}</a>
        {node.title ? <span class="text-ib-muted">— {node.title}</span> : ""}
      </div>
    ))}
  </div>
</div>
