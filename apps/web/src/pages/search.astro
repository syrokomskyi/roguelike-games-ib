---
/*
<MODULE_CONTRACT>
<purpose>Search page with semantic search, source/type filters, and concept type filtering.</purpose>
<non-goals>
  <item>Does not implement the search API — calls the search API Worker or local proxy.</item>
</non-goals>
</MODULE_CONTRACT>
<CHANGE_SUMMARY>
  <item>Initial creation: search page with source and type filters.</item>
  <item>RFC-0010: Added concept_type filter and Concepts only toggle.</item>
</CHANGE_SUMMARY>
*/
export const prerender = true;

import Base from "../layouts/Base.astro";
import SearchBox from "../components/SearchBox.astro";

---

<Base title="Search" activeNav="search">
  <div class="space-y-6">
    <h1 class="text-2xl font-bold text-ib-text">Search</h1>

    <SearchBox />

    <div id="search-results">
      <div id="search-status" class="text-sm text-ib-muted">Enter a search query to find records.</div>
    </div>
  </div>

  <script>
    const SEARCH_API = import.meta.env.PUBLIC_SEARCH_API_URL ?? "";

    interface ApiHit {
      key: string;
      record_type: string;
      source_id: string;
      title: string;
      summary: string;
      score: number;
      concept_type?: string;
      source_games?: string[];
      mutation_dimensions?: string[];
    }

    interface ApiResponse {
      hits: ApiHit[];
      total: number;
      query: string;
      mode: string;
    }

    const DISPLAY_LIMIT = 25;

    function initSearch() {
      const container = document.getElementById("search-results");
      if (!container) return;

      const pageParams = new URLSearchParams(window.location.search);
      const query = pageParams.get("q") ?? "";
      const source = pageParams.get("source") ?? "all";
      const type = pageParams.get("type") ?? "all";
      const conceptType = pageParams.get("concept_type") ?? "all";
      const status = document.getElementById("search-status");
      const searchInput = document.querySelector<HTMLInputElement>('input[name="q"]');
      if (searchInput) searchInput.value = query;

      if (!query.trim()) {
        if (status) status.textContent = "Enter a search query to find records by title, summary, or key.";
        return;
      }

      if (status) status.textContent = "Searching...";

      const params = new URLSearchParams({ q: query });
      if (source !== "all") params.set("source", source);
      if (type !== "all") params.set("type", type);
      if (conceptType !== "all") params.set("concept_type", conceptType);

      const apiUrl = SEARCH_API
        ? `${SEARCH_API}/api/search?${params.toString()}`
        : `/api/search?${params.toString()}`;

      fetch(apiUrl)
        .then((res) => {
          if (!res.ok) throw new Error(`HTTP ${res.status}`);
          return res.json() as Promise<ApiResponse>;
        })
        .then((data) => {
          renderResults(container, data, query, source, type, conceptType);
        })
        .catch(() => {
          if (status) {
            status.textContent = "Search temporarily unavailable. Please try again shortly.";
          }
        });
    }

    function renderResults(
      container: HTMLElement,
      data: ApiResponse,
      query: string,
      activeSource: string,
      activeType: string,
      activeConceptType: string,
    ) {
      const { hits, total } = data;

      if (total === 0) {
        container.innerHTML = `
          <p class="text-sm text-ib-muted">
            0 results for <span class="font-medium text-ib-text">"${escapeHtml(query)}"</span>
          </p>
          <p class="mt-4 text-sm text-ib-muted">No records found. Try a different query or adjust filters.</p>
        `;
        return;
      }

      const sourceSet = new Set<string>();
      const typeSet = new Set<string>();
      for (const h of hits) {
        if (h.source_id) sourceSet.add(h.source_id);
        if (h.record_type) typeSet.add(h.record_type);
      }
      const sources = [...sourceSet].sort();
      const types = [...typeSet].sort();

      let html = `
        <p class="text-sm text-ib-muted">
          ${total} result${total !== 1 ? "s" : ""} for <span class="font-medium text-ib-text">"${escapeHtml(query)}"</span>
          <span class="ml-2 rounded-full bg-ib-accent/15 px-2 py-0.5 text-xs text-ib-accent">semantic</span>
        </p>
      `;

      if (sources.length > 1) {
        html += `<div class="flex flex-wrap gap-2"><span class="text-sm text-ib-muted py-1.5">Source:</span>`;
        html += filterLink("source", "all", activeSource === "all");
        for (const s of sources) {
          html += filterLink("source", s, activeSource === s);
        }
        html += `</div>`;
      }

      if (types.length > 1) {
        html += `<div class="flex flex-wrap gap-2"><span class="text-sm text-ib-muted py-1.5">Type:</span>`;
        html += filterLink("type", "all", activeType === "all");
        for (const t of types) {
          html += filterLink("type", t, activeType === t);
        }
        html += `</div>`;
      }

      const CONCEPT_TYPES = [
        "cross_game_mechanic", "design_primitive", "design_pressure",
        "design_knob", "mutation_vector", "counterplay_pattern",
        "failure_mode", "player_sensation", "design_tension",
        "negative_space", "emergent_pattern", "synergy_pattern",
      ];

      const hasConcepts = hits.some((h) => h.concept_type);
      if (hasConcepts || activeConceptType !== "all") {
        html += `<div class="flex flex-wrap gap-2"><span class="text-sm text-ib-muted py-1.5">Concept type:</span>`;
        html += filterLink("concept_type", "all", activeConceptType === "all");
        for (const ct of CONCEPT_TYPES) {
          const active = activeConceptType === ct;
          const count = hits.filter((h) => h.concept_type === ct).length;
          if (count > 0 || active) {
            html += filterLink("concept_type", ct, active);
          }
        }
        html += `</div>`;
      }

      html += `<div class="space-y-3">`;
      for (const hit of hits.slice(0, DISPLAY_LIMIT)) {
        html += `
          <a href="/records/${encodeURIComponent(hit.key)}/" class="block rounded-xl border border-ib-border bg-ib-surface p-4 transition-colors hover:border-ib-accent">
            <div class="flex items-center gap-2">
              <span class="inline-block h-8 w-8 shrink-0"></span>
              <span class="font-mono text-xs text-ib-accent">${escapeHtml(hit.key)}</span>
              <span class="rounded-md bg-ib-accent/15 px-1.5 py-0.5 text-xs text-ib-accent">${escapeHtml(hit.record_type)}</span>
              ${hit.source_id ? `<span class="text-xs text-ib-muted">${escapeHtml(hit.source_id)}</span>` : ""}
            </div>
            ${hit.title ? `<h3 class="mt-1 font-semibold text-ib-text">${escapeHtml(hit.title)}</h3>` : ""}
            ${hit.summary ? `<p class="mt-1 text-sm text-ib-muted line-clamp-2">${escapeHtml(hit.summary)}</p>` : ""}
            <div class="mt-2 flex items-center gap-3 text-xs text-ib-muted">
              <span>Score: ${hit.score.toFixed(3)}</span>
              ${hit.source_games?.length ? `<span>Games: ${hit.source_games.map(escapeHtml).join(", ")}</span>` : ""}
            </div>
          </a>
        `;
      }
      html += `</div>`;

      if (total > DISPLAY_LIMIT) {
        html += `<p class="text-center text-sm text-ib-muted">Showing ${DISPLAY_LIMIT} of ${total} results. Refine your query for more specific results.</p>`;
      }

      container.innerHTML = html;
    }

    function filterLink(param: string, value: string, active: boolean): string {
      const url = new URL(window.location.href);
      if (value === "all") {
        url.searchParams.delete(param);
      } else {
        url.searchParams.set(param, value);
      }
      url.searchParams.delete("page");
      const cls = active
        ? "border border-ib-accent bg-ib-accent/15 text-ib-accent"
        : "border border-ib-border bg-ib-surface text-ib-muted hover:text-ib-text";
      return `<a href="${url.pathname}?${url.searchParams.toString()}" class="rounded-lg px-3 py-1.5 text-sm ${cls}">${escapeHtml(value)}</a>`;
    }

    function escapeHtml(s: string): string {
      return s
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#39;");
    }

    initSearch();

    document.addEventListener("astro:after-swap", initSearch);
  </script>
</Base>
