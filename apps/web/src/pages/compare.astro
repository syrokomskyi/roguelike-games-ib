---
export const prerender = false;

import Base from "../layouts/Base.astro";
import { createWebContext } from "../lib/context.ts";
import { getPageMetadata } from "../lib/metadata.ts";
import CompareTable from "../components/CompareTable.astro";
import { claimsForRecord, relationsForRecord } from "@roguelike-games-ib/projection-sdk";

const distDir = Astro.locals.distDir ?? "";
const ctx = await createWebContext(distDir);
const meta = getPageMetadata(ctx);

const records = ctx.store.records;
const allRows = records.map((r) => {
  const claims = claimsForRecord(ctx.store.claims, r.id);
  const { outgoing, incoming } = relationsForRecord(ctx.store.relations, r.id);
  return {
    record_id: r.id,
    record_key: r.key,
    record_type: r.record_type,
    title: (r as Record<string, unknown>)["title"] as string | null ?? null,
    summary: (r as Record<string, unknown>)["summary"] as string | null ?? null,
    claim_count: claims.length,
    outgoing_relation_count: outgoing.length,
    incoming_relation_count: incoming.length,
  };
});

const types = [...new Set(allRows.map((r) => r.record_type))].sort();
const sources = [...new Set(records.map((r) => {
  const si = (r as Record<string, unknown>)["source_identity"] as Record<string, unknown> | undefined;
  const scope = (r as Record<string, unknown>)["scope"] as Record<string, unknown> | undefined;
  return (si?.["source_id"] as string | undefined) ?? (scope?.["source_id"] as string | undefined);
}).filter(Boolean))].sort();

const activeType = Astro.url.searchParams.get("type") ?? "all";
const activeSource = Astro.url.searchParams.get("source") ?? "all";
const PAGE_SIZE = 25;
const page = Number(Astro.url.searchParams.get("page") ?? "1");

let filtered = allRows;
if (activeType !== "all") filtered = filtered.filter((r) => r.record_type === activeType);
if (activeSource !== "all") {
  filtered = filtered.filter((r) => {
    const rec = records.find((rr) => rr.id === r.record_id);
    const si = (rec as Record<string, unknown>)["source_identity"] as Record<string, unknown> | undefined;
    const scope = (rec as Record<string, unknown>)["scope"] as Record<string, unknown> | undefined;
    return si?.["source_id"] === activeSource || scope?.["source_id"] === activeSource;
  });
}

const totalPages = Math.ceil(filtered.length / PAGE_SIZE);
const currentPage = Math.min(Math.max(1, page), totalPages || 1);
const pageRows = filtered.slice((currentPage - 1) * PAGE_SIZE, currentPage * PAGE_SIZE);
---

<Base title="Compare" metadata={meta}>
  <div class="space-y-6">
    <h1 class="text-2xl font-bold text-ib-text">Compare Records</h1>
    <p class="text-ib-muted">{filtered.length} of {allRows.length} records</p>

    <div class="flex flex-wrap gap-2">
      <a href={`/compare/`} class={`rounded-lg px-3 py-1.5 text-sm ${activeType === "all" && activeSource === "all" ? "bg-ib-accent text-white" : "border border-ib-border bg-ib-surface text-ib-muted hover:text-ib-text"}`}>All</a>
      {types.map((t) => (
        <a href={`/compare/?type=${t}`} class={`rounded-lg px-3 py-1.5 text-sm ${activeType === t ? "bg-ib-accent text-white" : "border border-ib-border bg-ib-surface text-ib-muted hover:text-ib-text"}`}>{t}</a>
      ))}
    </div>

    {sources.length > 1 && (
      <div class="flex flex-wrap gap-2">
        <span class="text-sm text-ib-muted py-1.5">Source:</span>
        <a href={`/compare/?type=${activeType}`} class={`rounded-lg px-3 py-1.5 text-sm ${activeSource === "all" ? "bg-ib-accent2 text-white" : "border border-ib-border bg-ib-surface text-ib-muted hover:text-ib-text"}`}>all</a>
        {sources.map((s) => (
          <a href={`/compare/?type=${activeType}&source=${s}`} class={`rounded-lg px-3 py-1.5 text-sm ${activeSource === s ? "bg-ib-accent2 text-white" : "border border-ib-border bg-ib-surface text-ib-muted hover:text-ib-text"}`}>{s}</a>
        ))}
      </div>
    )}

    <CompareTable rows={pageRows} />

    {totalPages > 1 && (
      <div class="flex items-center justify-center gap-2">
        {currentPage > 1 && (
          <a href={`/compare/?type=${activeType}&source=${activeSource}&page=${currentPage - 1}`} class="rounded-lg border border-ib-border bg-ib-surface px-3 py-1.5 text-sm text-ib-muted hover:text-ib-text">← Prev</a>
        )}
        <span class="text-sm text-ib-muted">Page {currentPage} of {totalPages}</span>
        {currentPage < totalPages && (
          <a href={`/compare/?type=${activeType}&source=${activeSource}&page=${currentPage + 1}`} class="rounded-lg border border-ib-border bg-ib-surface px-3 py-1.5 text-sm text-ib-muted hover:text-ib-text">Next →</a>
        )}
      </div>
    )}
  </div>
</Base>
