---
import Base from "../../../layouts/Base.astro";
import { createWebContext } from "../../../lib/context.ts";
import { getPageMetadata } from "../../../lib/metadata.ts";
import { resolve } from "node:path";

interface MechanicRecord {
  key: string;
  title: string | undefined;
  summary: string | undefined;
}

export async function getStaticPaths() {
  const distDir = process.env.PROJECTION_DIST_DIR ?? resolve(process.cwd(), "../../.generated/knowledge/dist");
  const ctx = await createWebContext(distDir);
  const meta = getPageMetadata(ctx);

  return ctx.store.sources.map((source) => {
    const sourceId = source.source_id;
    const records: MechanicRecord[] = ctx.store.records.filter((r) => {
      const isMechanic = r.record_type === "mechanic" || (r.record_type === "semantic_record" && (r as Record<string, unknown>)["semantic_type"] === "mechanic");
      if (!isMechanic) return false;
      const si = (r as Record<string, unknown>)["source_identity"] as Record<string, unknown> | undefined;
      const scope = (r as Record<string, unknown>)["scope"] as Record<string, unknown> | undefined;
      return si?.["source_id"] === sourceId || scope?.["source_id"] === sourceId;
    }).map((r) => ({
      key: r.key,
      title: (r as Record<string, unknown>)["title"] as string | undefined,
      summary: (r as Record<string, unknown>)["summary"] as string | undefined,
    }));

    return {
      params: { sourceId },
      props: { sourceId, records, meta },
    };
  });
}

const { sourceId, records, meta } = Astro.props;
---

<Base title={`Mechanics — ${sourceId}`} metadata={meta}>
  <div class="space-y-6">
    <div class="flex items-center gap-3">
      <h1 class="text-2xl font-bold text-ib-text">Mechanics</h1>
      <span class="rounded-md bg-ib-surface2 px-2 py-1 text-sm text-ib-muted">{sourceId}</span>
    </div>
    {records.length > 0 ? (
      <div class="grid gap-3 sm:grid-cols-2">
        {records.map((r) => (
          <a href={`/records/${r.key}/`} class="block rounded-lg border border-ib-border bg-ib-surface p-4 hover:border-ib-accent">
            <div class="font-mono text-xs text-ib-accent">{r.key}</div>
            {r.title && <div class="mt-1 text-sm text-ib-text">{r.title}</div>}
            {r.summary && <div class="mt-1 text-xs text-ib-muted line-clamp-2">{r.summary}</div>}
          </a>
        ))}
      </div>
    ) : (
      <p class="text-sm text-ib-muted">No mechanics records found for this source.</p>
    )}
  </div>
</Base>
