---
import Base from "../../../layouts/Base.astro";
import { createWebContext } from "../../../lib/context";
import { getPageMetadata } from "../../../lib/metadata";
import { systemsForSource } from "../../../lib/page-data";
import { keyToSpriteUrl } from "../../../lib/sprite";
import { resolve } from "node:path";

export async function getStaticPaths() {
  const distDir = process.env.PROJECTION_DIST_DIR ?? resolve(process.cwd(), "../../.generated/knowledge/dist");
  const ctx = await createWebContext(distDir);
  const meta = getPageMetadata(ctx);

  return ctx.store.sources.map((source) => {
    const sourceId = source.source_id;
    const records = systemsForSource(ctx.store, sourceId);

    return {
      params: { sourceId },
      props: { sourceId, records, meta },
    };
  });
}

const { sourceId, records, meta } = Astro.props;
---

<Base title={`Systems — ${sourceId}`} metadata={meta} activeNav="games">
  <div class="space-y-6">
    <div class="flex items-center gap-3">
      <h1 class="text-2xl font-bold text-ib-text">Systems</h1>
      <span class="rounded-md bg-ib-surface2 px-2 py-1 text-sm text-ib-muted">{sourceId}</span>
    </div>
    {records.length > 0 ? (
      <div class="grid gap-3 sm:grid-cols-2">
        {records.map((r) => (
          <a href={`/records/${r.key}/`} class="flex items-start gap-2 rounded-lg border border-ib-border bg-ib-surface p-4 transition-colors hover:border-ib-accent">
            <img src={keyToSpriteUrl(r.key)} alt="" loading="lazy" class="mt-0.5 h-8 w-8 shrink-0 object-cover" onerror="this.style.display='none'" />
            <div class="min-w-0">
              <div class="font-mono text-xs text-ib-accent">{r.key}</div>
              {r.title && <div class="mt-1 text-sm text-ib-text">{r.title}</div>}
              {r.summary && <div class="mt-1 text-xs text-ib-muted line-clamp-2">{r.summary}</div>}
            </div>
          </a>
        ))}
      </div>
    ) : (
      <p class="text-sm text-ib-muted">No systems records found for this source.</p>
    )}
  </div>
</Base>
