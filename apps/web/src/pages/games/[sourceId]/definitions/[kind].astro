---
import Base from "../../../../layouts/Base.astro";
import { createWebContext } from "../../../../lib/context.ts";
import { getPageMetadata } from "../../../../lib/metadata.ts";
import { readRecords, readSources } from "@roguelike-games-ib/projection-sdk";
import { resolve } from "node:path";

export function getStaticPaths() {
  const distDir = resolve(process.cwd(), "../../.generated/knowledge/dist");
  let sources: { source_id: string }[] = [];
  let records: { record_type: string; source_identity?: Record<string, unknown> }[] = [];
  try {
    sources = readSources(distDir);
    records = readRecords(distDir) as typeof records;
  } catch {}
  const kinds = new Set<string>();
  for (const r of records) {
    const si = r.source_identity as Record<string, unknown> | undefined;
    if (si?.source_id) kinds.add(r.record_type);
  }
  const paths: { params: { sourceId: string; kind: string } }[] = [];
  for (const s of sources) {
    for (const k of kinds) {
      paths.push({ params: { sourceId: s.source_id, kind: k } });
    }
  }
  return paths;
}

const { sourceId, kind } = Astro.params;
const distDir = Astro.locals.distDir ?? "";
const ctx = await createWebContext(distDir);
const meta = getPageMetadata(ctx);

const records = ctx.store.records.filter((r) => {
  if (r.record_type !== kind) return false;
  const si = (r as Record<string, unknown>)["source_identity"] as Record<string, unknown> | undefined;
  return si?.["source_id"] === sourceId;
});
---

<Base title={`${kind} — ${sourceId}`} metadata={meta}>
  <div class="space-y-6">
    <div class="flex items-center gap-3">
      <h1 class="text-2xl font-bold text-ib-text">Definitions: {kind}</h1>
      <span class="rounded-md bg-ib-surface2 px-2 py-1 text-sm text-ib-muted">{sourceId}</span>
    </div>
    <p class="text-ib-muted">{records.length} records</p>
    <div class="grid gap-2 sm:grid-cols-2">
      {records.map((r) => (
        <a href={`/records/${r.key}/`} class="block rounded-lg border border-ib-border bg-ib-surface p-3 hover:border-ib-accent">
          <div class="font-mono text-xs text-ib-accent">{r.key}</div>
        </a>
      ))}
    </div>
  </div>
</Base>
