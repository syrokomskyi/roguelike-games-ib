---
import Base from "../../../../layouts/Base.astro";
import { createWebContext } from "../../../../lib/context";
import { getPageMetadata } from "../../../../lib/metadata";
import { defRecordsForSourceKind, kindsForSource } from "../../../../lib/page-data";
import SpriteIcon from "../../../../components/SpriteIcon.astro";
import { resolve } from "node:path";

export async function getStaticPaths() {
  const distDir = process.env.PROJECTION_DIST_DIR ?? resolve(process.cwd(), "../../.generated/knowledge/dist");
  const ctx = await createWebContext(distDir);
  const meta = getPageMetadata(ctx);

  const paths = [];

  for (const source of ctx.store.sources) {
    const sourceId = source.source_id;
    const kinds = kindsForSource(ctx.store, sourceId);

    for (const kind of kinds) {
      const records = defRecordsForSourceKind(ctx.store, sourceId, kind);

      paths.push({
        params: { sourceId, kind },
        props: { sourceId, kind, records, meta },
      });
    }
  }

  return paths;
}

const { sourceId, kind, records, meta } = Astro.props;
---

<Base title={`${kind} — ${sourceId}`} metadata={meta} activeNav="games">
  <div class="space-y-6">
    <div class="flex items-center gap-3">
      <h1 class="text-2xl font-bold text-ib-text">Definitions: {kind}</h1>
      <span class="rounded-md bg-ib-surface2 px-2 py-1 text-sm text-ib-muted">{sourceId}</span>
    </div>
    <p class="text-ib-muted">{records.length} records</p>
    <div class="grid gap-2 sm:grid-cols-2">
      {records.map((r) => (
        <a href={`/records/${r.key}/`} class="flex items-center gap-2 rounded-lg border border-ib-border bg-ib-surface p-3 transition-colors hover:border-ib-accent">
          <SpriteIcon spritePath={r.sprite_path} sourceId={sourceId} size={32} />
          <div class="font-mono text-xs text-ib-accent">{r.key}</div>
        </a>
      ))}
    </div>
  </div>
</Base>
