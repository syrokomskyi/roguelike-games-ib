---
import Base from "../../../layouts/Base.astro";
import { createWebContext } from "../../../lib/context";
import { getPageMetadata } from "../../../lib/metadata";
import SourceBindingPanel from "../../../components/SourceBindingPanel.astro";
import CoveragePanel from "../../../components/CoveragePanel.astro";
import { recordsForSource } from "../../../lib/page-data";
import { resolve } from "node:path";

export async function getStaticPaths() {
  const PAGE_SIZE = 50;
  const distDir = process.env.PROJECTION_DIST_DIR ?? resolve(process.cwd(), "../../.generated/knowledge/dist");
  const ctx = await createWebContext(distDir);
  const meta = getPageMetadata(ctx);

  const paths = [];

  for (const source of ctx.store.sources) {
    const sourceId = source.source_id;
    const records = recordsForSource(ctx.store, sourceId);

    const byTypeMap = new Map<string, number>();
    for (const r of records) {
      byTypeMap.set(r.record_type, (byTypeMap.get(r.record_type) ?? 0) + 1);
    }
    const byType = [...byTypeMap.entries()].sort(([a], [b]) => a.localeCompare(b));
    const types = ["all", ...[...byTypeMap.keys()].sort()];
    const coverage = ctx.store.coverage.filter((c) => c.source_id === sourceId);

    for (const type of types) {
      const filtered = type === "all" ? records : records.filter((r) => r.record_type === type);
      const totalPages = Math.ceil(filtered.length / PAGE_SIZE);
      const maxPage = Math.max(1, totalPages);

      for (let page = 1; page <= maxPage; page++) {
        const isDefault = type === "all" && page === 1;
        paths.push({
          params: { sourceId, filter: isDefault ? undefined : [type, String(page)].join("/") },
          props: {
            sourceId,
            pageRecords: filtered.slice((page - 1) * PAGE_SIZE, page * PAGE_SIZE),
            filteredCount: filtered.length,
            totalCount: records.length,
            byType,
            activeType: type,
            currentPage: page,
            totalPages,
            source,
            coverage,
            meta,
          },
        });
      }
    }
  }

  return paths;
}

const { sourceId, pageRecords, filteredCount, totalCount, byType, activeType, currentPage, totalPages, source, coverage, meta } = Astro.props;

function gameUrl(sourceId: string, type: string, page: number): string {
  if (type === "all" && page === 1) return `/games/${sourceId}/`;
  return `/games/${sourceId}/${type}/${page}/`;
}
---

<Base title={sourceId ?? "Game"} metadata={meta}>
  <div class="space-y-6">
    {source && <SourceBindingPanel binding={source} />}

    <div class="flex flex-wrap gap-2">
      <a href={gameUrl(sourceId, "all", 1)} class={`rounded-lg px-3 py-1.5 text-sm ${activeType === "all" ? "border border-ib-accent bg-ib-accent/15 text-ib-accent" : "border border-ib-border bg-ib-surface text-ib-muted hover:text-ib-text"}`}>All ({totalCount})</a>
      {byType.map(([type, count]) => (
        <a href={gameUrl(sourceId, type, 1)} class={`rounded-lg px-3 py-1.5 text-sm ${activeType === type ? "border border-ib-accent bg-ib-accent/15 text-ib-accent" : "border border-ib-border bg-ib-surface text-ib-muted hover:text-ib-text"}`}>{type} ({count})</a>
      ))}
    </div>

    <div class="rounded-xl border border-ib-border bg-ib-surface p-5">
      <h2 class="mb-4 text-lg font-semibold text-ib-text">Records ({filteredCount})</h2>
      <div class="grid gap-2 sm:grid-cols-2">
        {pageRecords.map((r) => (
          <a href={`/records/${r.key}/`} class="flex items-center gap-2 rounded-lg border border-ib-border bg-ib-surface2 px-3 py-2 text-sm hover:border-ib-accent">
            <span class="font-mono text-xs text-ib-accent">{r.key}</span>
            <span class="rounded-md bg-ib-accent/15 px-1.5 py-0.5 text-xs text-ib-accent">{r.record_type}</span>
          </a>
        ))}
      </div>
    </div>

    {totalPages > 1 && (
      <div class="flex items-center justify-center gap-2">
        {currentPage > 1 && (
          <a href={gameUrl(sourceId, activeType, currentPage - 1)} class="rounded-lg border border-ib-border bg-ib-surface px-3 py-1.5 text-sm text-ib-muted hover:text-ib-text">← Prev</a>
        )}
        <span class="text-sm text-ib-muted">Page {currentPage} of {totalPages}</span>
        {currentPage < totalPages && (
          <a href={gameUrl(sourceId, activeType, currentPage + 1)} class="rounded-lg border border-ib-border bg-ib-surface px-3 py-1.5 text-sm text-ib-muted hover:text-ib-text">Next →</a>
        )}
      </div>
    )}

    <div>
      <h2 class="mb-3 text-lg font-semibold text-ib-text">Coverage</h2>
      <CoveragePanel coverage={coverage} />
    </div>

    <div class="flex gap-4">
      <a href={`/games/${sourceId}/mechanics/`} class="rounded-lg border border-ib-border bg-ib-surface px-4 py-2 text-sm text-ib-text hover:border-ib-accent">Mechanics</a>
      <a href={`/games/${sourceId}/systems/`} class="rounded-lg border border-ib-border bg-ib-surface px-4 py-2 text-sm text-ib-text hover:border-ib-accent">Systems</a>
    </div>
  </div>
</Base>
