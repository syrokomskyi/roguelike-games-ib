---
import Base from "../../layouts/Base.astro";
import { createWebContext } from "../../lib/context";
import { getPageMetadata } from "../../lib/metadata";
import { countRecordsBySource } from "../../lib/page-data";

const distDir = Astro.locals.distDir ?? "";
const ctx = await createWebContext(distDir);
const meta = getPageMetadata(ctx);

const sources = ctx.store.sources;
const recordsBySource = countRecordsBySource(ctx.store);
const typesBySource = new Map<string, Map<string, number>>();
for (const r of ctx.store.records) {
  const si = (r as Record<string, unknown>)["source_identity"] as Record<string, unknown> | undefined;
  const sid = si?.["source_id"] as string | undefined;
  if (!sid) continue;
  if (!typesBySource.has(sid)) typesBySource.set(sid, new Map());
  const typeMap = typesBySource.get(sid)!;
  typeMap.set(r.record_type, (typeMap.get(r.record_type) ?? 0) + 1);
}

const sortedSources = [...sources].sort((a, b) =>
  (recordsBySource.get(b.source_id) ?? 0) - (recordsBySource.get(a.source_id) ?? 0),
);
---

<Base title="Games" metadata={meta} activeNav="games">
  <header class="grid gap-8 border-b border-ib-text pb-12 lg:grid-cols-[1fr_auto] lg:items-end">
    <div><p class="atlas-label text-ib-accent">Game Atlas</p><h1 class="mt-5 text-5xl font-medium tracking-[-.045em] sm:text-7xl">Mapped territories.</h1><p class="mt-5 max-w-2xl text-lg text-ib-muted">Games are not endpoints. Enter through a source and trace its definitions, mechanics, systems, and evidence.</p></div>
    <p class="font-mono text-xs uppercase tracking-widest text-ib-muted">{sources.length} registered sources</p>
  </header>
  <div class="border-b border-ib-text">
    {sortedSources.map((s) => {
      const total = recordsBySource.get(s.source_id) ?? 0;
      const typeMap = typesBySource.get(s.source_id);
      const types = typeMap ? [...typeMap.entries()].sort(([a], [b]) => a.localeCompare(b)) : [];
      return (
        <div class="group relative grid gap-5 border-b border-ib-border py-8 transition-colors last:border-b-0 hover:bg-ib-surface/50 sm:grid-cols-[1.1fr_.6fr_1.3fr_auto] sm:items-center sm:px-4">
          <a href={`/games/${s.source_id}/`} class="absolute inset-0" aria-label={s.source_id}></a>
          <div><span class="font-mono text-lg text-ib-accent">@</span><h2 class="mt-2 text-2xl font-medium text-ib-text">{s.source_id}</h2><span class="font-mono text-xs text-ib-muted">v{s.declared_version}</span></div>
          <div><strong class="text-2xl font-medium">{total}</strong><small class="block font-mono text-xs uppercase tracking-wider text-ib-muted">records</small></div>
          {types.length > 1 && (
            <div class="flex flex-wrap gap-x-4 gap-y-2">
              {types.map(([type, count]) => (
                <span class="font-mono text-xs text-ib-muted">{type} <b class="text-ib-text">{count}</b></span>
              ))}
            </div>
          )}<span class="text-2xl text-ib-muted transition-transform group-hover:translate-x-2 group-hover:text-ib-accent">→</span>
        </div>
      );
    })}
  </div>
</Base>
