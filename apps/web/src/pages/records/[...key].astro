---
import Base from "../../layouts/Base.astro";
import { resolve } from "node:path";
import { createWebContext } from "../../lib/context";
import { getPageMetadata } from "../../lib/metadata";
import { evidenceForRecord } from "../../lib/evidence";
import { claimsForRecord, claimsReferencingRecord, relationsForRecord } from "@roguelike-games-ib/projection-sdk";
import type { CanonicalRecord } from "@roguelike-games-ib/materializer";
import RecordHeader from "../../components/RecordHeader.astro";
import RecordAttributes from "../../components/RecordAttributes.astro";
import EvidenceList from "../../components/EvidenceList.astro";
import RelationGraph from "../../components/RelationGraph.astro";

const distDir = process.env.PROJECTION_DIST_DIR ?? resolve(process.cwd(), "../../.generated/knowledge/dist");

export async function getStaticPaths() {
  const staticDistDir = process.env.PROJECTION_DIST_DIR ?? resolve(process.cwd(), "../../.generated/knowledge/dist");
  const ctx = await createWebContext(staticDistDir);
  return ctx.store.records.map((record) => ({
    params: { key: record.key },
    props: { record },
  }));
}

const ctx = await createWebContext(distDir);
const meta = getPageMetadata(ctx);
const record = Astro.props.record as CanonicalRecord;
const claims = claimsForRecord(ctx.store.claims, record.id);
const refClaims = claimsReferencingRecord(ctx.store.claims, record.id);
const { outgoing, incoming } = relationsForRecord(ctx.store.relations, record.id);
const allRelations = [...outgoing, ...incoming];
const recordEvidenceRefs = ((record as Record<string, unknown>)["evidence_refs"] as string[]) ?? [];
const evidenceRefs = [...claims.flatMap((c) => c.evidence_refs), ...refClaims.flatMap((c) => c.evidence_refs), ...recordEvidenceRefs];
const evidence = evidenceForRecord(ctx.store.evidence, evidenceRefs, ctx.store.sources, record.id);
const assertionState = claims.length > 0 ? claims[0].assertion_state : undefined;

const isImageAsset = record.record_type === "image_asset" || (record as Record<string, unknown>)["kind"] === "image_asset";
const imageEvidence = isImageAsset ? evidence.find((e) => e.evidence_kind === "asset" && e.media && e.github_url) : null;

const spritePath = ((record as Record<string, unknown>)["attributes"] as Record<string, unknown> | undefined)?.["sprite_path"] as string | null | undefined;
const recordSourceId = ((record as Record<string, unknown>)["source_identity"] as Record<string, unknown> | undefined)?.["source_id"] as string | undefined;
const spriteUrl = spritePath && recordSourceId ? `/sprites/${encodeURIComponent(recordSourceId)}/${encodeURIComponent(spritePath.split("/").pop()!)}` : null;
---

<Base title={record.key} metadata={meta}>
  <div class="space-y-12">
    <RecordHeader record={record} authority="canonical" assertionState={assertionState} canonicalHash={ctx.canonicalHash} />

    {imageEvidence && (
      <section>
        <h2 class="atlas-label mb-4 text-ib-muted">00 / Image</h2>
        <div class="h-48 w-48 overflow-hidden rounded-xl border border-ib-border bg-ib-surface">
          <img
            src={imageEvidence.github_url}
            alt={imageEvidence.media?.alt_text ?? imageEvidence.artifact_path ?? "image asset"}
            loading="lazy"
            class="h-full w-full object-cover"
          />
        </div>
        {imageEvidence.media && (
          <p class="mt-2 text-xs text-ib-muted">
            {imageEvidence.media.mime_type}
            {imageEvidence.media.width && imageEvidence.media.height && ` · ${imageEvidence.media.width}×${imageEvidence.media.height}px`}
          </p>
        )}
      </section>
    )}

    {spriteUrl && (
      <section>
        <h2 class="atlas-label mb-4 text-ib-muted">00 / Sprite</h2>
        <div class="overflow-hidden rounded-xl border border-ib-border" style="height:192px;width:fit-content">
          <img
            src={spriteUrl}
            alt={`Sprite of ${record.key}`}
            loading="lazy"
            class="h-full w-auto"
          />
        </div>
      </section>
    )}

    <RecordAttributes record={record} />

    <section>
      <h2 class="atlas-label mb-4 text-ib-muted">02 / Claims <span>({claims.length})</span></h2>
      {claims.length > 0 ? (
        <div class="space-y-2">
          {claims.map((c) => (
            <div class="border-l-2 border-ib-blue bg-ib-surface p-4">
              <div class="flex items-center gap-2 text-sm">
                <strong class="text-ib-accent2">{c.predicate}</strong>
                {c.object_ref && <span class="text-ib-muted">→ <span class="font-mono text-xs">{c.object_ref}</span></span>}
                {c.value !== undefined && <span class="text-ib-muted">= <code class="text-ib-text">{JSON.stringify(c.value)}</code></span>}
                <span class={`rounded-md px-2 py-0.5 text-xs ${c.assertion_state === "supported" ? "bg-ib-green/15 text-ib-green" : c.assertion_state === "contested" ? "bg-ib-red/15 text-ib-red" : "bg-ib-surface2 text-ib-muted"}`}>{c.assertion_state}</span>
              </div>
            </div>
          ))}
        </div>
      ) : (
        <p class="text-sm text-ib-muted">No claims recorded.</p>
      )}
      {refClaims.length > 0 && (
        <div class="mt-3 space-y-2">
          <h3 class="text-sm font-medium text-ib-muted">Referenced by claims</h3>
          {refClaims.map((c) => (
            <div class="rounded-lg border border-ib-border bg-ib-surface p-3">
              <div class="flex items-center gap-2 text-sm">
                <span class="text-ib-muted font-mono text-xs">{c.subject_id}</span>
                <strong class="text-ib-accent2">{c.predicate}</strong>
                <span class={`rounded-md px-2 py-0.5 text-xs ${c.assertion_state === "supported" ? "bg-ib-green/15 text-ib-green" : c.assertion_state === "contested" ? "bg-ib-red/15 text-ib-red" : "bg-ib-surface2 text-ib-muted"}`}>{c.assertion_state}</span>
              </div>
            </div>
          ))}
        </div>
      )}
    </section>

    <section>
      <h2 class="atlas-label mb-4 text-ib-muted">03 / Evidence inspector</h2>
      <EvidenceList evidence={evidence} />
    </section>

    <section>
      <h2 class="atlas-label mb-4 text-ib-muted">04 / Local relation graph</h2>
      <RelationGraph relations={allRelations} records={ctx.store.records.map((r) => {
        const ra = r as Record<string, unknown>;
        const attrs = ra["attributes"] as Record<string, unknown> | undefined;
        const si = ra["source_identity"] as Record<string, unknown> | undefined;
        return { id: r.id, key: r.key, record_type: r.record_type, sprite_path: (attrs?.["sprite_path"] as string | null) ?? null, source_id: (si?.["source_id"] as string | undefined) ?? "" };
      })} />
    </section>
  </div>
</Base>
