---
import Base from "../layouts/Base.astro";
---

<Base title="404">
  <div class="flex flex-col items-center justify-center py-20 text-center">
    <h1 class="text-6xl font-bold text-ib-accent">404</h1>
    <p class="mt-4 text-lg text-ib-muted">The requested page was not found.</p>
    <a href="/" class="mt-6 rounded-lg bg-ib-accent px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-ib-accent2">Return home</a>
  </div>
</Base>
