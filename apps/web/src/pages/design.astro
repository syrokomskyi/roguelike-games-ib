---
import Base from "../layouts/Base.astro";
import { createWebContext } from "../lib/context";
import { getPageMetadata } from "../lib/metadata";
import { buildDesignData } from "../lib/design-data";

const distDir = Astro.locals.distDir ?? "";
const ctx = await createWebContext(distDir);
const meta = getPageMetadata(ctx);

const { concepts, primitives, conceptCards, primitiveCards, designRelationCards, realizesCards } = buildDesignData(ctx.store);
---

<Base title="Design Explorer" metadata={meta} activeNav="design">
  <div class="space-y-6">
    <h1 class="text-2xl font-bold text-ib-text">Design Space Explorer</h1>

    <section class="rounded-xl border border-ib-border bg-ib-surface p-5">
      <h2 class="mb-3 text-lg font-semibold text-ib-text">Cross-Game Concepts <span class="text-sm font-normal text-ib-muted">({concepts.length})</span></h2>
      {concepts.length > 0 ? (
        <div class="grid gap-3 sm:grid-cols-2">
          {conceptCards.map((c) => (
            <a href={`/records/${c.key}/`} class="block rounded-lg border border-ib-border bg-ib-surface2 p-4 transition-colors hover:border-ib-accent">
              <div class="font-semibold text-ib-text">{c.title}</div>
              {c.definition && <p class="mt-1 text-sm text-ib-muted line-clamp-2">{c.definition}</p>}
              {c.sourceGames.length > 0 && (
                <div class="mt-2 flex flex-wrap gap-1">
                  {c.sourceGames.map((g: string) => (
                    <span class="rounded bg-ib-accent/20 px-1.5 py-0.5 text-xs text-ib-accent">{g}</span>
                  ))}
                </div>
              )}
              {c.mutationDimensions.length > 0 && (
                <div class="mt-1.5 flex flex-wrap gap-1">
                  {c.mutationDimensions.map((d: string) => (
                    <span class="rounded bg-ib-surface px-1.5 py-0.5 text-xs text-ib-muted">{d}</span>
                  ))}
                </div>
              )}
              <div class="mt-2 font-mono text-xs text-ib-accent">{c.key}</div>
            </a>
          ))}
        </div>
      ) : (
        <p class="text-sm text-ib-muted">No cross-game concepts yet.</p>
      )}
    </section>

    <section class="rounded-xl border border-ib-border bg-ib-surface p-5">
      <h2 class="mb-3 text-lg font-semibold text-ib-text">Design Primitives <span class="text-sm font-normal text-ib-muted">({primitives.length})</span></h2>
      {primitives.length > 0 ? (
        <div class="grid gap-3 sm:grid-cols-2">
          {primitiveCards.map((p) => (
            <a href={`/records/${p.key}/`} class="block rounded-lg border border-ib-border bg-ib-surface2 p-4 transition-colors hover:border-ib-accent">
              <div class="font-semibold text-ib-text">{p.title}</div>
              {p.definition && <p class="mt-1 text-sm text-ib-muted line-clamp-2">{p.definition}</p>}
              {p.sourceGames.length > 0 && (
                <div class="mt-2 flex flex-wrap gap-1">
                  {p.sourceGames.map((g: string) => (
                    <span class="rounded bg-ib-accent/20 px-1.5 py-0.5 text-xs text-ib-accent">{g}</span>
                  ))}
                </div>
              )}
              {p.mutationDimensions.length > 0 && (
                <div class="mt-1.5 flex flex-wrap gap-1">
                  {p.mutationDimensions.map((d: string) => (
                    <span class="rounded bg-ib-surface px-1.5 py-0.5 text-xs text-ib-muted">{d}</span>
                  ))}
                </div>
              )}
              <div class="mt-2 font-mono text-xs text-ib-accent">{p.key}</div>
            </a>
          ))}
        </div>
      ) : (
        <p class="text-sm text-ib-muted">No design primitives yet.</p>
      )}
    </section>

    <section class="rounded-xl border border-ib-border bg-ib-surface p-5">
      <h2 class="mb-3 text-lg font-semibold text-ib-text">Design Relations <span class="text-sm font-normal text-ib-muted">({designRelationCards.length})</span></h2>
      {designRelationCards.length > 0 ? (
        <ul class="space-y-2">
          {designRelationCards.map((rel) => (
            <li class="rounded-lg border border-ib-border bg-ib-surface2 p-3">
              <div class="text-sm">
                <a href={`/records/${rel.sourceKey}/`} class="text-ib-accent hover:text-ib-accent2">{rel.sourceKey}</a>
                <span class="text-ib-accent2"> —{rel.relationType}→ </span>
                <a href={`/records/${rel.targetKey}/`} class="text-ib-accent hover:text-ib-accent2">{rel.targetKey}</a>
              </div>
              {rel.rationale && <p class="mt-1 text-xs text-ib-muted">{rel.rationale}</p>}
            </li>
          ))}
        </ul>
      ) : (
        <p class="text-sm text-ib-muted">No design relations yet.</p>
      )}
    </section>

    <section class="rounded-xl border border-ib-border bg-ib-surface p-5">
      <h2 class="mb-3 text-lg font-semibold text-ib-text">Cross-Game Realizations <span class="text-sm font-normal text-ib-muted">({realizesCards.length})</span></h2>
      {realizesCards.length > 0 ? (
        <ul class="space-y-2">
          {realizesCards.map((rel) => (
            <li class="rounded-lg border border-ib-border bg-ib-surface2 p-3">
              <div class="text-sm">
                <a href={`/records/${rel.sourceKey}/`} class="text-ib-accent hover:text-ib-accent2">{rel.sourceKey}</a>
                <span class="text-ib-accent2"> realizes → </span>
                <a href={`/records/${rel.targetKey}/`} class="text-ib-accent hover:text-ib-accent2">{rel.targetKey}</a>
              </div>
              <div class="mt-1 text-xs text-ib-muted">
                {rel.sourceRecordType} → {rel.targetRecordType}
              </div>
            </li>
          ))}
        </ul>
      ) : (
        <p class="text-sm text-ib-muted">No cross-game realizations yet.</p>
      )}
    </section>
  </div>
</Base>
