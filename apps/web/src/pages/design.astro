<!--
<MODULE_CONTRACT>
<purpose>Renders the design space explorer page showing cross-game concepts, design primitives, and design relations from the projection store.</purpose>
<non-goals>
  <item>Does not compute design relations — rendering of projection store data only.</item>
</non-goals>
</MODULE_CONTRACT>
<CHANGE_SUMMARY>
  <item>Initial creation: design page with concept cards, primitive cards, and relation list.</item>
</CHANGE_SUMMARY>
-->
---
import Base from "../layouts/Base.astro";
import { createWebContext } from "../lib/context.ts";
import { getPageMetadata } from "../lib/metadata.ts";

const distDir = Astro.locals.distDir ?? "";
const ctx = await createWebContext(distDir);
const meta = getPageMetadata(ctx);

const allConcepts = ctx.store.records.filter((r) => r.record_type === "concept");
const concepts = allConcepts.filter((r) => (r as Record<string, unknown>)["concept_type"] !== "design_primitive");
const primitives = allConcepts.filter((r) => (r as Record<string, unknown>)["concept_type"] === "design_primitive");
const designRelations = ctx.store.relations.filter((r) => r.relation_scope === "design");

const conceptCards = concepts.map((r) => ({
  key: r.key,
  title: (r as Record<string, unknown>)["title"] as string | null ?? r.key,
  summary: (r as Record<string, unknown>)["summary"] as string | null,
}));

const primitiveCards = primitives.map((r) => ({
  key: r.key,
  title: (r as Record<string, unknown>)["title"] as string | null ?? r.key,
  definition: (r as Record<string, unknown>)["definition"] as string | null,
}));

const idToKey = new Map(ctx.store.records.map((r) => [r.id, r.key]));
---

<Base title="Design Explorer" metadata={meta}>
  <div class="space-y-6">
    <h1 class="text-2xl font-bold text-ib-text">Design Space Explorer</h1>

    <section class="rounded-xl border border-ib-border bg-ib-surface p-5">
      <h2 class="mb-3 text-lg font-semibold text-ib-text">Cross-Game Concepts <span class="text-sm font-normal text-ib-muted">({concepts.length})</span></h2>
      {concepts.length > 0 ? (
        <div class="grid gap-3 sm:grid-cols-2">
          {conceptCards.map((c) => (
            <a href={`/records/${c.key}/`} class="block rounded-lg border border-ib-border bg-ib-surface2 p-4 hover:border-ib-accent">
              <div class="font-semibold text-ib-text">{c.title}</div>
              {c.summary && <p class="mt-1 text-sm text-ib-muted line-clamp-2">{c.summary}</p>}
              <div class="mt-2 font-mono text-xs text-ib-accent">{c.key}</div>
            </a>
          ))}
        </div>
      ) : (
        <p class="text-sm text-ib-muted">No cross-game concepts yet.</p>
      )}
    </section>

    <section class="rounded-xl border border-ib-border bg-ib-surface p-5">
      <h2 class="mb-3 text-lg font-semibold text-ib-text">Design Primitives <span class="text-sm font-normal text-ib-muted">({primitives.length})</span></h2>
      {primitives.length > 0 ? (
        <div class="grid gap-3 sm:grid-cols-2">
          {primitiveCards.map((p) => (
            <a href={`/records/${p.key}/`} class="block rounded-lg border border-ib-border bg-ib-surface2 p-4 hover:border-ib-accent">
              <div class="font-semibold text-ib-text">{p.title}</div>
              {p.definition && <p class="mt-1 text-sm text-ib-muted line-clamp-2">{p.definition}</p>}
              <div class="mt-2 font-mono text-xs text-ib-accent">{p.key}</div>
            </a>
          ))}
        </div>
      ) : (
        <p class="text-sm text-ib-muted">No design primitives yet.</p>
      )}
    </section>

    <section class="rounded-xl border border-ib-border bg-ib-surface p-5">
      <h2 class="mb-3 text-lg font-semibold text-ib-text">Design Relations <span class="text-sm font-normal text-ib-muted">({designRelations.length})</span></h2>
      {designRelations.length > 0 ? (
        <ul class="space-y-1">
          {designRelations.map((rel) => (
            <li class="text-sm text-ib-muted">
              <a href={`/records/${idToKey.get(rel.source_record_id) ?? ""}/`} class="text-ib-accent hover:text-ib-accent2">{idToKey.get(rel.source_record_id) ?? rel.source_record_id}</a>
              <span class="text-ib-accent2"> —{rel.relation_type}→ </span>
              <a href={`/records/${idToKey.get(rel.target_record_id) ?? ""}/`} class="text-ib-accent hover:text-ib-accent2">{idToKey.get(rel.target_record_id) ?? rel.target_record_id}</a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="text-sm text-ib-muted">No design relations yet.</p>
      )}
    </section>
  </div>
</Base>
