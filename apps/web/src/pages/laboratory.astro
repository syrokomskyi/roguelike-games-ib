---
/*
<MODULE_CONTRACT>
<purpose>Laboratory page — accepts a sensation word, context, and excluded mechanics, then generates a structured design dossier client-side from build-time concept data (RFC-0013).</purpose>
<non-goals>
  <item>Does not perform LLM enhancement — uses template fallback for why_relevant.</item>
  <item>Does not call any server endpoint — all dossier generation is client-side.</item>
</non-goals>
</MODULE_CONTRACT>
<CHANGE_SUMMARY>
  <item>RFC-0013: Initial creation — renamed from inspiration.astro, added client-side dossier generation.</item>
</CHANGE_SUMMARY>
*/
import Base from "../layouts/Base.astro";
import { createWebContext } from "../lib/context";
import { getPageMetadata } from "../lib/metadata";
import { designRelationTypes } from "../lib/design-data";

const distDir = Astro.locals.distDir ?? "";
const ctx = await createWebContext(distDir);
const meta = getPageMetadata(ctx);

const conceptRecords = ctx.store.records
  .filter((r) => r.record_type === "concept")
  .map((r) => {
    const ra = r as unknown as Record<string, unknown>;
    const ancestry = ra["ancestry"] as Record<string, unknown> | undefined;
    return {
      key: r.key,
      title: (ra["title"] as string) ?? r.key,
      definition: (ra["definition"] as string) ?? "",
      concept_type: (ra["concept_type"] as string) ?? "unknown",
      quality_score: (ra["quality_score"] as { coverage: number; evidence: number; richness: number; overall: number } | undefined) ?? null,
      concrete_examples: (ra["concrete_examples"] as { game: string; description: string }[] | undefined) ?? null,
      ancestry: ancestry ? {
        source_games: (ancestry["source_games"] as string[]) ?? [],
        derived_from: (ancestry["derived_from"] as string[]) ?? [],
      } : null,
    };
  });

const idToKey = new Map(ctx.store.records.map((r) => [r.id, r.key]));
const relevantRelationTypes = new Set([
  "HAS_MUTATION_VECTOR", "IMPLEMENTED_AS", "tensions_with",
  ...designRelationTypes,
]);
const relationRecords = ctx.store.relations
  .filter((r) => relevantRelationTypes.has(r.relation_type))
  .map((r) => {
    const ra = r as unknown as Record<string, unknown>;
    const qualifiers = ra["qualifiers"] as Record<string, unknown> | undefined;
    return {
      source_key: idToKey.get(r.source_record_id) ?? r.source_record_id,
      target_key: idToKey.get(r.target_record_id) ?? r.target_record_id,
      relation_type: r.relation_type,
      rationale: (qualifiers?.["rationale"] as string) ?? null,
    };
  });

const conceptData = JSON.stringify(conceptRecords);
const relationData = JSON.stringify(relationRecords);
---

<Base title="Laboratory" metadata={meta} activeNav="laboratory" world="laboratory">
  <header class="grid gap-10 border-b border-ib-border pb-14 lg:grid-cols-[1fr_auto] lg:items-end">
    <div>
      <div class="flex items-center gap-3"><span class="atlas-label text-ib-accent">Laboratory</span><span class="border border-ib-accent px-2 py-1 font-mono text-[10px] uppercase tracking-wider text-ib-accent">Non-canonical</span></div>
      <h1 class="mt-6 max-w-4xl text-5xl font-medium leading-[1.02] tracking-[-.045em] sm:text-7xl">Leave the mapped territory.</h1>
      <p class="mt-6 max-w-2xl text-lg leading-8 text-ib-muted">Set a desired sensation, a context, and the familiar devices you refuse to use. Begin with a grounded dossier, then carry its visible ancestry into future mutations.</p>
    </div>
    <div class="font-mono text-8xl text-ib-accent/30">*</div>
  </header>

  <section class="grid border-b border-ib-border lg:grid-cols-[.7fr_1.3fr]">
    <div class="border-b border-ib-border py-10 lg:border-b-0 lg:border-r lg:pr-10">
      <p class="atlas-label text-ib-muted">Example constraints</p>
      <dl class="mt-8 space-y-7">
        <div><dt class="font-mono text-xs uppercase text-ib-muted">Sensation</dt><dd class="mt-2 text-xl">Dread</dd></div>
        <div><dt class="font-mono text-xs uppercase text-ib-muted">Context</dt><dd class="mt-2 text-xl">Cave exploration</dd></div>
        <div><dt class="font-mono text-xs uppercase text-ib-muted">Excluded</dt><dd class="mt-3 flex flex-wrap gap-2">{["darkness", "hunger", "sanity", "durability"].map((term) => <span class="border border-ib-border px-2.5 py-1 font-mono text-xs text-ib-muted"><s>{term}</s></span>)}</dd></div>
      </dl>
    </div>
    <div class="py-10 lg:pl-12">
      <label for="lab-sensation" class="atlas-label text-ib-accent">Sensation</label>
      <input id="lab-sensation" type="text" placeholder="dread" class="mt-3 w-full border border-ib-border bg-ib-surface p-3 text-lg text-ib-text placeholder-ib-muted focus:outline-none" />
      <label for="lab-context" class="atlas-label text-ib-muted mt-5 block">Context (optional)</label>
      <input id="lab-context" type="text" placeholder="cave exploration" class="mt-3 w-full border border-ib-border bg-ib-surface p-3 text-lg text-ib-text placeholder-ib-muted focus:outline-none" />
      <label for="lab-excluded" class="atlas-label text-ib-muted mt-5 block">Excluded mechanics (comma-separated)</label>
      <input id="lab-excluded" type="text" placeholder="hunger, darkness, sanity" class="mt-3 w-full border border-ib-border bg-ib-surface p-3 text-lg text-ib-text placeholder-ib-muted focus:outline-none" />
      <div class="mt-5 flex items-center justify-between gap-4">
        <p class="font-mono text-xs text-ib-muted" id="lab-status">Enter a sensation to generate a dossier.</p>
        <button id="lab-generate" class="border border-ib-accent bg-ib-accent px-5 py-3 font-mono text-xs uppercase tracking-wider text-white transition-colors hover:bg-transparent hover:text-ib-accent">Generate dossier →</button>
      </div>
      <noscript>
        <p class="mt-4 font-mono text-xs text-ib-muted">Enable JavaScript to generate a dossier, or visit <a href="/ask" class="text-ib-accent underline">the Q&A page</a> for a text-based query.</p>
      </noscript>
    </div>
  </section>

  <section id="lab-results" class="py-14 hidden">
  </section>

  <section class="py-14" id="lab-explainer">
    <div class="flex items-center justify-between"><p class="atlas-label text-ib-muted">How ideas are formed</p><span class="atlas-coordinate">LINEAGE / 01</span></div>
    <div class="mt-10 grid items-center gap-5 lg:grid-cols-[1fr_auto_1fr_auto_1fr]">
      <div class="border border-ib-border bg-ib-surface p-5"><span class="font-mono text-xs text-ib-accent">01</span><p class="mt-4 text-lg">information scarcity</p><small class="mt-2 block font-mono text-xs text-ib-muted">canonical structure</small></div>
      <span class="hidden font-mono text-ib-accent lg:block">+</span>
      <div class="border border-ib-border bg-ib-surface p-5"><span class="font-mono text-xs text-ib-accent">02</span><p class="mt-4 text-lg">spatial commitment</p><small class="mt-2 block font-mono text-xs text-ib-muted">canonical structure</small></div>
      <span class="hidden font-mono text-ib-accent lg:block">+</span>
      <div class="border border-ib-border bg-ib-surface p-5"><span class="font-mono text-xs text-ib-accent">03</span><p class="mt-4 text-lg">selective perception</p><small class="mt-2 block font-mono text-xs text-ib-muted">canonical structure</small></div>
    </div>
    <div class="mt-8 border-l-2 border-ib-accent pl-6"><p class="atlas-label text-ib-accent">Why this exists</p><p class="mt-3 max-w-3xl text-ib-muted">Each design seed exposes this trail: source structures → mutation operation → resulting possibility. The boundary between evidence and invention stays visible.</p></div>
  </section>
</Base>

<script type="application/json" id="lab-concept-data" set:html={conceptData} />
<script type="application/json" id="lab-relation-data" set:html={relationData} />

<script>
  import { generateDossier, type ConceptData, type RelationData, type DossierOutput } from "../lib/laboratory";

  const conceptData: ConceptData[] = JSON.parse(document.getElementById("lab-concept-data")?.textContent || "[]");
  const relationData: RelationData[] = JSON.parse(document.getElementById("lab-relation-data")?.textContent || "[]");

  const sensationInput = document.getElementById("lab-sensation") as HTMLInputElement;
  const contextInput = document.getElementById("lab-context") as HTMLInputElement;
  const excludedInput = document.getElementById("lab-excluded") as HTMLInputElement;
  const generateBtn = document.getElementById("lab-generate") as HTMLButtonElement;
  const resultsSection = document.getElementById("lab-results") as HTMLElement;
  const explainerSection = document.getElementById("lab-explainer") as HTMLElement;
  const statusEl = document.getElementById("lab-status") as HTMLElement;

  function renderDossier(dossier: DossierOutput): string {
    const d = dossier.dossier;
    const html: string[] = [];

    if (d.relevant_primitives.length === 0 && d.relevant_pressures.length === 0) {
      html.push('<div class="border border-ib-border bg-ib-surface p-8"><p class="text-lg text-ib-muted">All matching structures were excluded. Try removing some constraints.</p></div>');
    } else {
      if (d.relevant_primitives.length > 0) {
        html.push('<div class="mb-10"><p class="atlas-label text-ib-accent">Relevant primitives</p><div class="mt-5 grid gap-4 md:grid-cols-2">');
        for (const p of d.relevant_primitives) {
          const score = p.quality_score ? '<span class="border border-ib-border px-2 py-0.5 font-mono text-[10px] text-ib-muted">Q:' + p.quality_score.overall.toFixed(2) + '</span>' : '';
          html.push('<div class="border border-ib-border bg-ib-surface p-5"><div class="flex items-center justify-between"><span class="font-mono text-xs text-ib-accent">' + p.key + '</span>' + score + '</div><h3 class="mt-3 text-lg">' + p.title + '</h3><p class="mt-2 text-sm text-ib-muted">' + p.definition + '</p><p class="mt-3 border-l-2 border-ib-accent pl-3 text-sm text-ib-muted">' + p.why_relevant + '</p></div>');
        }
        html.push('</div></div>');
      }

      if (d.relevant_pressures.length > 0) {
        html.push('<div class="mb-10"><p class="atlas-label text-ib-accent">Relevant pressures</p><div class="mt-5 grid gap-4 md:grid-cols-2">');
        for (const p of d.relevant_pressures) {
          html.push('<div class="border border-ib-border bg-ib-surface p-5"><span class="font-mono text-xs text-ib-accent">' + p.key + '</span><h3 class="mt-3 text-lg">' + p.title + '</h3><p class="mt-2 text-sm text-ib-muted">' + p.definition + '</p></div>');
        }
        html.push('</div></div>');
      }

      if (d.mutation_vectors.length > 0) {
        html.push('<div class="mb-10"><p class="atlas-label text-ib-accent">Mutation vectors</p><div class="mt-5 space-y-3">');
        for (const m of d.mutation_vectors) {
          const knobs = m.available_knobs.length > 0 ? '<div class="mt-3 flex flex-wrap gap-2">' + m.available_knobs.map((k) => '<span class="border border-ib-border px-2 py-1 font-mono text-[10px] text-ib-muted">' + k + '</span>').join("") + '</div>' : '';
          html.push('<details class="border border-ib-border bg-ib-surface"><summary class="cursor-pointer p-4 font-mono text-sm text-ib-accent">' + m.key + ' — ' + m.title + '</summary><div class="border-t border-ib-border p-4"><p class="text-sm text-ib-muted">' + m.definition + '</p>' + knobs + '</div></details>');
        }
        html.push('</div></div>');
      }

      if (d.concrete_examples.length > 0) {
        html.push('<div class="mb-10"><p class="atlas-label text-ib-accent">Concrete examples</p><div class="mt-5 space-y-3">');
        for (const ex of d.concrete_examples) {
          html.push('<div class="border-l-2 border-ib-accent pl-4"><span class="font-mono text-xs text-ib-accent">' + ex.game + '</span><p class="mt-1 text-sm text-ib-text">' + ex.example + '</p><small class="mt-1 block font-mono text-[10px] text-ib-muted">' + ex.primitive + '</small></div>');
        }
        html.push('</div></div>');
      }

      if (d.ancestry_trail.length > 0) {
        html.push('<div class="mb-10"><p class="atlas-label text-ib-accent">Ancestry trail</p><div class="mt-5 space-y-2">');
        for (const t of d.ancestry_trail) {
          const typeLabel = t.type === "source_structure" ? "structure" : t.type === "mutation" ? "mutation" : "possibility";
          html.push('<div class="flex items-center gap-4"><span class="font-mono text-xs text-ib-muted">' + String(t.step).padStart(2, "0") + '</span><span class="border border-ib-border px-2 py-0.5 font-mono text-[10px] uppercase text-ib-muted">' + typeLabel + '</span><span class="text-sm text-ib-text">' + t.description + '</span></div>');
        }
        html.push('</div></div>');
      }

      if (d.design_tensions.length > 0) {
        html.push('<div class="mb-10"><p class="atlas-label text-ib-accent">Design tensions</p><div class="mt-5 space-y-3">');
        for (const t of d.design_tensions) {
          html.push('<div class="border border-ib-border bg-ib-surface p-4"><p class="font-mono text-sm text-ib-accent">' + t.tension + '</p><p class="mt-2 text-sm text-ib-muted">' + t.description + '</p></div>');
        }
        html.push('</div></div>');
      }

      if (d.excluded_mechanics_filtered.length > 0) {
        html.push('<div class="mb-10"><p class="atlas-label text-ib-muted">Excluded mechanics</p><div class="mt-3 space-y-2">');
        for (const e of d.excluded_mechanics_filtered) {
          html.push('<div class="flex items-center gap-3"><span class="font-mono text-xs text-ib-muted"><s>' + e.requested_exclusion + '</s></span><span class="font-mono text-[10px] text-ib-muted">filtered: ' + e.filtered_concepts.join(", ") + '</span></div>');
        }
        html.push('</div></div>');
      }
    }

    return html.join("");
  }

  generateBtn.addEventListener("click", () => {
    const sensation = sensationInput.value.trim();
    if (!sensation) {
      statusEl.textContent = "Enter a sensation word (e.g. dread, tension, discovery).";
      return;
    }
    const context = contextInput.value.trim() || null;
    const excluded = excludedInput.value.split(",").map((s) => s.trim()).filter(Boolean);

    statusEl.textContent = "Generating dossier…";
    const dossier = generateDossier(sensation, context, excluded, conceptData, relationData);

    resultsSection.innerHTML = renderDossier(dossier);
    resultsSection.classList.remove("hidden");
    explainerSection.classList.add("hidden");
    statusEl.textContent = "Dossier generated for sensation: " + sensation;
  });

  const params = new URLSearchParams(window.location.search);
  const qParam = params.get("q");
  if (qParam) {
    sensationInput.value = qParam;
    generateBtn.click();
  }
</script>
