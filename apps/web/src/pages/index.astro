---
import Base from "../layouts/Base.astro";
import SearchBox from "../components/SearchBox.astro";
import { createWebContext } from "../lib/context";
import { getStats } from "../lib/page-data";

const distDir = Astro.locals.distDir ?? "";
const ctx = await createWebContext(distDir);
const stats = getStats(ctx.store);

const examples = [
  "Create dread without darkness",
  "Pressure without timers",
  "Mechanics that alter space",
  "Information as a resource",
];

const paths = [
  { index: "01", glyph: "@", title: "Explore games", copy: "Follow source → mechanic → evidence", href: "/games/", tone: "canonical" },
  { index: "02", glyph: "#", title: "Explore design space", copy: "Compare structures across games", href: "/design/", tone: "derived" },
  { index: "03", glyph: "*", title: "Enter laboratory", copy: "Turn known structures into possibilities", href: "/inspiration", tone: "laboratory" },
];
---

<Base title="Design Space Atlas" fullWidth>
  <section class="relative overflow-hidden border-b border-ib-border">
    <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
      <svg class="absolute right-[-8rem] top-[-5rem] h-[44rem] w-[52rem] opacity-70" viewBox="0 0 800 700" fill="none">
        <path d="M713 127C607 43 457 51 346 124c-89 58-138 159-114 256 25 102 130 188 252 185 128-4 242-106 254-227 7-73-31-154-96-188-74-39-183-19-225 52-38 64-8 153 58 186 55 27 133 10 161-44 23-45 2-105-42-125-37-17-84-1-100 34" stroke="var(--color-ib-border)"/>
        <path d="M755 90C619-21 423-10 283 87 164 170 102 307 139 436c39 137 183 242 341 237 166-5 316-132 333-287" stroke="var(--color-ib-border)"/>
        <path d="M666 171C586 111 477 119 397 169c-67 42-106 116-91 189 15 76 92 143 183 145 95 2 188-70 204-157" stroke="var(--color-ib-accent)" stroke-opacity=".32"/>
        <circle cx="444" cy="253" r="5" fill="var(--color-ib-accent)"/><circle cx="586" cy="344" r="4" fill="var(--color-ib-blue)"/><circle cx="306" cy="358" r="4" fill="var(--color-ib-amber)"/>
      </svg>
    </div>

    <div class="relative mx-auto grid min-h-[720px] max-w-[90rem] items-center gap-16 px-5 py-20 lg:grid-cols-[1.15fr_.85fr] lg:px-8">
      <div class="max-w-3xl">
        <div class="mb-8 flex items-center gap-4"><span class="atlas-label text-ib-accent">Design Space Atlas</span><span class="h-px w-16 bg-ib-border"></span><span class="atlas-coordinate">52.5200° N · 13.4050° E</span></div>
        <h1 class="max-w-3xl text-5xl font-medium leading-[.94] tracking-[-.055em] text-ib-text sm:text-7xl lg:text-[6.4rem]">
          Map how<br />roguelikes work.
        </h1>
        <p class="mt-8 max-w-2xl text-lg leading-8 text-ib-muted sm:text-xl">
          Trace design from source code to mechanic, from mechanic to structure — and from known structures to <span class="text-ib-text">new possibilities.</span>
        </p>

        <div class="mt-12 max-w-2xl">
          <p class="atlas-label mb-3 text-ib-muted">Ask the design space</p>
          <SearchBox placeholder="What are you trying to design?" />
          <div class="mt-5 flex flex-wrap gap-x-6 gap-y-2">
            {examples.map((example) => <a class="text-sm text-ib-muted transition-colors hover:text-ib-accent" href={`/search?q=${encodeURIComponent(example)}`}>{example} <span aria-hidden="true">→</span></a>)}
          </div>
        </div>
      </div>

      <div class="relative hidden min-h-[34rem] lg:block" aria-label="Knowledge path from source to possible design">
        <div class="absolute left-10 top-9 font-mono text-xs text-ib-muted">SOURCE WORLD</div>
        <div class="map-node absolute left-4 top-20 border-ib-text"><b>&#123; &#125;</b><span>source</span><small>verified</small></div>
        <div class="map-line absolute left-[9.5rem] top-[8.9rem] w-32 rotate-[8deg]"></div>
        <div class="map-note absolute left-44 top-20">supports</div>
        <div class="map-node absolute right-12 top-32 border-ib-accent"><b>!</b><span>mechanic</span><small>canonical</small></div>
        <div class="map-line absolute right-28 top-[14.2rem] h-28 w-px rotate-[20deg]"></div>
        <div class="map-note absolute right-3 top-[17rem]">abstracts to</div>
        <div class="map-node absolute bottom-28 left-32 border-ib-blue"><b>#</b><span>primitive</span><small>derived</small></div>
        <div class="map-line absolute bottom-[10.5rem] left-[17rem] w-36 -rotate-[16deg]"></div>
        <div class="map-note absolute bottom-[7.2rem] left-[22rem]">mutation</div>
        <div class="map-node absolute bottom-6 right-0 border-ib-accent2"><b>*</b><span>possibility</span><small>laboratory</small></div>
      </div>
    </div>
  </section>

  {stats && (
    <section class="border-b border-ib-border bg-ib-surface/60">
      <div class="mx-auto grid max-w-[90rem] grid-cols-2 px-5 sm:grid-cols-4 lg:px-8">
        <div class="stat"><strong>{stats.sources}</strong><span>games mapped</span></div>
        <div class="stat"><strong>{stats.records.toLocaleString()}</strong><span>definitions</span></div>
        <div class="stat"><strong>{(stats.mechanics + stats.systems).toLocaleString()}</strong><span>mechanics + systems</span></div>
        <div class="stat"><strong>{stats.concepts.toLocaleString()}</strong><span>design concepts</span></div>
      </div>
    </section>
  )}

  <section class="mx-auto max-w-[90rem] px-5 py-24 lg:px-8 lg:py-32">
    <div class="grid gap-12 lg:grid-cols-[.75fr_1.25fr]">
      <div>
        <p class="atlas-label text-ib-accent">Choose a bearing</p>
        <h2 class="mt-5 max-w-md text-4xl font-medium leading-tight tracking-[-.035em] sm:text-5xl">Three ways into the territory.</h2>
        <p class="mt-6 max-w-sm leading-7 text-ib-muted">Start with what exists, move through the structures beneath it, or cross the boundary into what could exist.</p>
      </div>
      <div class="border-t border-ib-text">
        {paths.map((path) => (
          <a href={path.href} class={`path-row path-${path.tone} group grid grid-cols-[3rem_3rem_1fr_auto] items-center gap-3 border-b border-ib-border py-7 hover:no-underline`}>
            <span class="font-mono text-xs text-ib-muted">{path.index}</span><span class="font-mono text-2xl">{path.glyph}</span>
            <span><b class="block text-xl font-medium capitalize">{path.title}</b><small class="mt-1 block text-sm text-ib-muted">{path.copy}</small></span>
            <span class="text-2xl transition-transform group-hover:translate-x-2">→</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="border-y border-ib-border bg-ib-surface">
    <div class="mx-auto grid max-w-[90rem] lg:grid-cols-2">
      <div class="border-b border-ib-border px-5 py-20 lg:border-b-0 lg:border-r lg:px-16 lg:py-28">
        <p class="atlas-label text-ib-accent">Canonical / known</p>
        <h2 class="mt-5 text-4xl font-medium tracking-[-.035em]">Knowledge with a way down.</h2>
        <p class="mt-6 max-w-xl leading-7 text-ib-muted">Every assertion can be followed through claim and evidence to its exact source. Provenance is not footnote furniture; it is part of the instrument.</p>
        <div class="mt-12 border-l-2 border-ib-accent pl-6 font-mono text-sm">
          <div class="text-ib-text">hidden spatial field</div><div class="my-2 text-ib-muted">↓ REALIZED_BY</div><div class="text-ib-text">scent propagation</div><div class="my-2 text-ib-muted">↓ SUPPORTED_BY</div><div class="text-ib-accent">src/…/updateScent()</div>
        </div>
      </div>
      <div class="relative overflow-hidden bg-[#211d2c] px-5 py-20 text-[#f0edf5] lg:px-16 lg:py-28">
        <div class="absolute right-8 top-8 font-mono text-8xl text-[#7357d9]/15">*</div>
        <p class="atlas-label text-[#a993ff]">Laboratory / possible</p>
        <h2 class="mt-5 text-4xl font-medium tracking-[-.035em]">Ideas with visible ancestry.</h2>
        <p class="mt-6 max-w-xl leading-7 text-[#aaa4b5]">Creative mutations live in a different atmosphere and never impersonate facts. Every seed keeps the structures and constraints that caused it.</p>
        <a href="/inspiration" class="mt-10 inline-flex border-b border-[#a993ff] pb-2 font-mono text-sm uppercase tracking-wider text-[#c5b8ff]">Cross into Laboratory →</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .map-node { width: 10rem; height: 8rem; display: flex; flex-direction: column; justify-content: center; border-width: 1px; background: color-mix(in srgb, var(--color-ib-surface) 90%, transparent); padding: 1.25rem; box-shadow: 7px 7px 0 var(--color-ib-border); }
  .map-node b { font-family: var(--font-mono); font-size: 1.45rem; font-weight: 500; }
  .map-node span { margin-top: .65rem; font-size: .9rem; }
  .map-node small, .map-note { color: var(--color-ib-muted); font-family: var(--font-mono); font-size: .62rem; text-transform: uppercase; letter-spacing: .12em; }
  .map-node small { margin-top: .2rem; }
  .map-line { border-top: 1px solid var(--color-ib-border); transform-origin: left; }
  .stat { display: flex; min-height: 8rem; flex-direction: column; justify-content: center; border-right: 1px solid var(--color-ib-border); padding: 1.5rem; }
  .stat:last-child { border-right: 0; }
  .stat strong { font-size: 1.8rem; font-weight: 500; letter-spacing: -.04em; }
  .stat span { margin-top: .35rem; color: var(--color-ib-muted); font-family: var(--font-mono); font-size: .68rem; text-transform: uppercase; letter-spacing: .08em; }
  .path-canonical:hover { color: var(--color-ib-accent); }
  .path-derived:hover { color: var(--color-ib-blue); }
  .path-laboratory:hover { color: var(--color-ib-accent2); }
  @media (max-width: 639px) { .stat:nth-child(2) { border-right: 0; } .stat:nth-child(-n+2) { border-bottom: 1px solid var(--color-ib-border); } }
</style>
