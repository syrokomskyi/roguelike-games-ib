<!--
<MODULE_CONTRACT>
<purpose>Generates static comparison pages for all records with type and source filters, pagination, and a comparison table.</purpose>
<non-goals>
  <item>Does not compute comparison metrics — assembles rows from projection store data.</item>
</non-goals>
</MODULE_CONTRACT>
<CHANGE_SUMMARY>
  <item>Initial creation: compare page with getStaticPaths, type/source filters, pagination, and CompareTable.</item>
</CHANGE_SUMMARY>
-->
---
import Base from "../../layouts/Base.astro";
import { createWebContext } from "../../lib/context.ts";
import { getPageMetadata } from "../../lib/metadata.ts";
import CompareTable from "../../components/CompareTable.astro";
import { claimsForRecord, relationsForRecord } from "@roguelike-games-ib/projection-sdk";
import { resolve } from "node:path";

interface CompareRow {
  record_id: string;
  record_key: string;
  record_type: string;
  title: string | null;
  summary: string | null;
  claim_count: number;
  outgoing_relation_count: number;
  incoming_relation_count: number;
  source_id: string;
}

export async function getStaticPaths() {
  const PAGE_SIZE = 25;
  const distDir = process.env.PROJECTION_DIST_DIR ?? resolve(process.cwd(), "../../.generated/knowledge/dist");
  const ctx = await createWebContext(distDir);
  const records = ctx.store.records;

  const allRows: CompareRow[] = records.map((r) => {
    const claims = claimsForRecord(ctx.store.claims, r.id);
    const { outgoing, incoming } = relationsForRecord(ctx.store.relations, r.id);
    const si = (r as Record<string, unknown>)["source_identity"] as Record<string, unknown> | undefined;
    const scope = (r as Record<string, unknown>)["scope"] as Record<string, unknown> | undefined;
    const source_id = (si?.["source_id"] as string | undefined) ?? (scope?.["source_id"] as string | undefined) ?? "all";
    return {
      record_id: r.id,
      record_key: r.key,
      record_type: r.record_type,
      title: (r as Record<string, unknown>)["title"] as string | null ?? null,
      summary: (r as Record<string, unknown>)["summary"] as string | null ?? null,
      claim_count: claims.length,
      outgoing_relation_count: outgoing.length,
      incoming_relation_count: incoming.length,
      source_id,
    };
  });

  const types = [...new Set(allRows.map((r) => r.record_type))].sort();
  const sources = [...new Set(allRows.map((r) => r.source_id).filter((s) => s !== "all"))].sort();
  const allTypes = ["all", ...types];
  const allSources = ["all", ...sources];
  const meta = getPageMetadata(ctx);

  const paths: {
    params: { filter: string | undefined };
    props: {
      pageRows: CompareRow[];
      filteredCount: number;
      totalCount: number;
      types: string[];
      sources: string[];
      activeType: string;
      activeSource: string;
      currentPage: number;
      totalPages: number;
      meta: typeof meta;
    };
  }[] = [];

  for (const type of allTypes) {
    for (const source of allSources) {
      let filtered = allRows;
      if (type !== "all") filtered = filtered.filter((r) => r.record_type === type);
      if (source !== "all") filtered = filtered.filter((r) => r.source_id === source);

      const totalPages = Math.ceil(filtered.length / PAGE_SIZE);
      const maxPage = Math.max(1, totalPages);

      for (let page = 1; page <= maxPage; page++) {
        const isDefault = type === "all" && source === "all" && page === 1;
        paths.push({
          params: { filter: isDefault ? undefined : [type, source, String(page)].join("/") },
          props: {
            pageRows: filtered.slice((page - 1) * PAGE_SIZE, page * PAGE_SIZE),
            filteredCount: filtered.length,
            totalCount: allRows.length,
            types,
            sources,
            activeType: type,
            activeSource: source,
            currentPage: page,
            totalPages,
            meta,
          },
        });
      }
    }
  }

  return paths;
}

const { pageRows, filteredCount, totalCount, types, sources, activeType, activeSource, currentPage, totalPages, meta } = Astro.props;

function compareUrl(type: string, source: string, page: number): string {
  if (type === "all" && source === "all" && page === 1) return `/compare/`;
  return `/compare/${type}/${source}/${page}/`;
}
---

<Base title="Compare" metadata={meta}>
  <div class="space-y-6">
    <h1 class="text-2xl font-bold text-ib-text">Compare Records</h1>
    <p class="text-ib-muted">{filteredCount} of {totalCount} records</p>

    <div class="flex flex-wrap gap-2">
      <a href={compareUrl("all", activeSource, 1)} class={`rounded-lg px-3 py-1.5 text-sm ${activeType === "all" ? "bg-ib-accent text-white" : "border border-ib-border bg-ib-surface text-ib-muted hover:text-ib-text"}`}>All</a>
      {types.map((t) => (
        <a href={compareUrl(t, activeSource, 1)} class={`rounded-lg px-3 py-1.5 text-sm ${activeType === t ? "bg-ib-accent text-white" : "border border-ib-border bg-ib-surface text-ib-muted hover:text-ib-text"}`}>{t}</a>
      ))}
    </div>

    {sources.length > 1 && (
      <div class="flex flex-wrap gap-2">
        <span class="text-sm text-ib-muted py-1.5">Source:</span>
        <a href={compareUrl(activeType, "all", 1)} class={`rounded-lg px-3 py-1.5 text-sm ${activeSource === "all" ? "bg-ib-accent2 text-white" : "border border-ib-border bg-ib-surface text-ib-muted hover:text-ib-text"}`}>all</a>
        {sources.map((s) => (
          <a href={compareUrl(activeType, s, 1)} class={`rounded-lg px-3 py-1.5 text-sm ${activeSource === s ? "bg-ib-accent2 text-white" : "border border-ib-border bg-ib-surface text-ib-muted hover:text-ib-text"}`}>{s}</a>
        ))}
      </div>
    )}

    <CompareTable rows={pageRows} />

    {totalPages > 1 && (
      <div class="flex items-center justify-center gap-2">
        {currentPage > 1 && (
          <a href={compareUrl(activeType, activeSource, currentPage - 1)} class="rounded-lg border border-ib-border bg-ib-surface px-3 py-1.5 text-sm text-ib-muted hover:text-ib-text">← Prev</a>
        )}
        <span class="text-sm text-ib-muted">Page {currentPage} of {totalPages}</span>
        {currentPage < totalPages && (
          <a href={compareUrl(activeType, activeSource, currentPage + 1)} class="rounded-lg border border-ib-border bg-ib-surface px-3 py-1.5 text-sm text-ib-muted hover:text-ib-text">Next →</a>
        )}
      </div>
    )}
  </div>
</Base>
