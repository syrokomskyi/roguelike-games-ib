---
import Base from "../../layouts/Base.astro";
import { createWebContext } from "../../lib/context";
import { getPageMetadata } from "../../lib/metadata";
import CompareTable from "../../components/CompareTable.astro";
import CollapsibleSection from "../../components/CollapsibleSection.astro";
import { buildCompareRows } from "../../lib/page-data";
import { buildCoverageMatrix, buildDesignData } from "../../lib/design-data";
import { resolve } from "node:path";

export async function getStaticPaths() {
  const PAGE_SIZE = 25;
  const distDir = process.env.PROJECTION_DIST_DIR ?? resolve(process.cwd(), "../../.generated/knowledge/dist");
  const ctx = await createWebContext(distDir);

  const allRows = buildCompareRows(ctx.store);

  const types = [...new Set(allRows.map((r) => r.kind ?? r.record_type).filter(Boolean))].sort();
  const sources = [...new Set(allRows.map((r) => r.source_id).filter((s) => s !== "all"))].sort();
  const allTypes = ["all", ...types];
  const allSources = ["all", ...sources];
  const meta = getPageMetadata(ctx);
  const coverageData = buildCoverageMatrix(ctx.store);
  const { primitiveCards } = buildDesignData(ctx.store);
  const primitivePresence = primitiveCards.map((p) => ({ key: p.key, title: p.title, sourceGames: p.sourceGames }));

  const paths = [];

  for (const type of allTypes) {
    for (const source of allSources) {
      let filtered = allRows;
      if (type !== "all") filtered = filtered.filter((r) => (r.kind ?? r.record_type) === type);
      if (source !== "all") filtered = filtered.filter((r) => r.source_id === source);

      const totalPages = Math.ceil(filtered.length / PAGE_SIZE);
      const maxPage = Math.max(1, totalPages);

      for (let page = 1; page <= maxPage; page++) {
        const isDefault = type === "all" && source === "all" && page === 1;
        paths.push({
          params: { filter: isDefault ? undefined : [type, source, String(page)].join("/") },
          props: {
            pageRows: filtered.slice((page - 1) * PAGE_SIZE, page * PAGE_SIZE),
            filteredCount: filtered.length,
            totalCount: allRows.length,
            types,
            sources,
            activeType: type,
            activeSource: source,
            currentPage: page,
            totalPages,
            meta,
            coverageMatrix: coverageData.matrix,
            coverageConceptTypes: coverageData.conceptTypes,
            coverageSourceIds: coverageData.sourceIds,
            primitivePresence,
          },
        });
      }
    }
  }

  return paths;
}

const { pageRows, filteredCount, totalCount, types, sources, activeType, activeSource, currentPage, totalPages, meta, coverageMatrix, coverageConceptTypes, coverageSourceIds, primitivePresence } = Astro.props;

const PAGE_SIZE = 25;
const rangeStart = (currentPage - 1) * PAGE_SIZE + 1;
const rangeEnd = Math.min(currentPage * PAGE_SIZE, filteredCount);

function compareUrl(type: string, source: string, page: number): string {
  if (type === "all" && source === "all" && page === 1) return `/compare/`;
  return `/compare/${type}/${source}/${page}/`;
}
---

<Base title="Compare" metadata={meta} activeNav="compare">
  <div class="space-y-6">
    <h1 class="text-2xl font-bold text-ib-text">Compare Records</h1>
    <p class="text-ib-muted">{rangeStart}–{rangeEnd} of {filteredCount} records{filteredCount !== totalCount ? ` (${totalCount} total)` : ""}</p>

    <div class="flex flex-wrap gap-2">
      <a href={compareUrl("all", activeSource, 1)} class={`rounded-lg px-3 py-1.5 text-sm ${activeType === "all" ? "border border-ib-accent bg-ib-accent/15 text-ib-accent" : "border border-ib-border bg-ib-surface text-ib-muted hover:text-ib-text"}`}>All</a>
      {types.map((t) => (
        <a href={compareUrl(t, activeSource, 1)} class={`rounded-lg px-3 py-1.5 text-sm ${activeType === t ? "border border-ib-accent bg-ib-accent/15 text-ib-accent" : "border border-ib-border bg-ib-surface text-ib-muted hover:text-ib-text"}`}>{t}</a>
      ))}
    </div>

    {sources.length > 1 && (
      <div class="flex flex-wrap gap-2">
        <span class="text-sm text-ib-muted py-1.5">Source:</span>
        <a href={compareUrl(activeType, "all", 1)} class={`rounded-lg px-3 py-1.5 text-sm ${activeSource === "all" ? "border border-ib-accent2 bg-ib-accent2/15 text-ib-accent2" : "border border-ib-border bg-ib-surface text-ib-muted hover:text-ib-text"}`}>all</a>
        {sources.map((s) => (
          <a href={compareUrl(activeType, s, 1)} class={`rounded-lg px-3 py-1.5 text-sm ${activeSource === s ? "border border-ib-accent2 bg-ib-accent2/15 text-ib-accent2" : "border border-ib-border bg-ib-surface text-ib-muted hover:text-ib-text"}`}>{s}</a>
        ))}
      </div>
    )}

    {activeType === "all" && activeSource === "all" && currentPage === 1 && coverageConceptTypes.length > 0 && (
      <CollapsibleSection title="Concept coverage matrix" open>
        <div class="overflow-x-auto rounded-lg border border-ib-border">
          <table class="w-full border-collapse text-sm">
            <thead>
              <tr class="bg-ib-surface2 text-ib-muted">
                <th class="px-3 py-2 text-left">Game</th>
                {coverageConceptTypes.map((ct) => (
                  <th class="px-3 py-2 text-right">{ct}</th>
                ))}
              </tr>
            </thead>
            <tbody>
              {coverageSourceIds.map((sid) => (
                <tr class="border-t border-ib-border">
                  <td class="px-3 py-2 font-mono text-xs text-ib-text">{sid}</td>
                  {coverageConceptTypes.map((ct) => {
                    const count = coverageMatrix[sid]?.[ct] ?? 0;
                    return (
                      <td class={`px-3 py-2 text-right ${count > 0 ? "text-ib-text" : "text-ib-muted"}`}>{count > 0 ? count : "—"}</td>
                    );
                  })}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </CollapsibleSection>
    )}

    {activeType === "all" && activeSource === "all" && currentPage === 1 && primitivePresence.length > 0 && (
      <CollapsibleSection title="Design primitive presence">
        <div class="overflow-x-auto rounded-lg border border-ib-border">
          <table class="w-full border-collapse text-sm">
            <thead>
              <tr class="bg-ib-surface2 text-ib-muted">
                <th class="px-3 py-2 text-left">Primitive</th>
                {coverageSourceIds.map((sid) => (
                  <th class="px-3 py-2 text-center">{sid}</th>
                ))}
              </tr>
            </thead>
            <tbody>
              {primitivePresence.map((p) => (
                <tr class="border-t border-ib-border">
                  <td class="px-3 py-2">
                    <a href={`/records/${p.key}/`} class="font-mono text-xs text-ib-accent hover:text-ib-accent2">{p.title}</a>
                  </td>
                  {coverageSourceIds.map((sid) => {
                    const present = p.sourceGames.includes(sid);
                    return (
                      <td class="px-3 py-2 text-center">{present ? <span class="text-ib-green">✓</span> : <span class="text-ib-muted">—</span>}</td>
                    );
                  })}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </CollapsibleSection>
    )}

    <CompareTable rows={pageRows} />

    {totalPages > 1 && (
      <div class="flex items-center justify-center gap-2">
        {currentPage > 1 && (
          <a href={compareUrl(activeType, activeSource, currentPage - 1)} class="rounded-lg border border-ib-border bg-ib-surface px-3 py-1.5 text-sm text-ib-muted transition-colors hover:text-ib-text">← Prev</a>
        )}
        <span class="text-sm text-ib-muted">Page {currentPage} of {totalPages}</span>
        {currentPage < totalPages && (
          <a href={compareUrl(activeType, activeSource, currentPage + 1)} class="rounded-lg border border-ib-border bg-ib-surface px-3 py-1.5 text-sm text-ib-muted transition-colors hover:text-ib-text">Next →</a>
        )}
      </div>
    )}
  </div>
</Base>
