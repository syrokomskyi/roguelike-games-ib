---
import Base from "../../layouts/Base.astro";
import { resolve } from "node:path";
import { createWebContext } from "../../lib/context";
import { getPageMetadata } from "../../lib/metadata";
import { renderEvidence } from "../../lib/evidence";

const distDir = process.env.PROJECTION_DIST_DIR ?? resolve(process.cwd(), "../../.generated/knowledge/dist");

export async function getStaticPaths() {
  const staticDistDir = process.env.PROJECTION_DIST_DIR ?? resolve(process.cwd(), "../../.generated/knowledge/dist");
  const ctx = await createWebContext(staticDistDir);
  // Individual evidence is rendered on its canonical record page. Limiting this
  // index route to source-level dossiers keeps the CDN build bounded rather than
  // emitting one duplicate page for every evidence fragment.
  const recordIds = new Set(ctx.store.evidence.map((evidence) => evidence.source_id).filter(Boolean));
  return [...recordIds].map((recordId) => ({ params: { recordId } }));
}

const { recordId = "" } = Astro.params;
const ctx = await createWebContext(distDir);
const meta = getPageMetadata(ctx);

const evidence = ctx.store.evidence.filter((e) => e.source_id === recordId || e.id === recordId);
const rendered = renderEvidence(evidence, ctx.store.sources);
---

<Base title={`Evidence — ${recordId}`} metadata={meta} breadcrumbs={[{ label: "Atlas", href: "/" }, { label: "Games", href: "/games/" }, { label: recordId, href: `/games/${recordId}/` }, { label: "Evidence" }]}>
  <div class="space-y-6">
    <h1 class="text-2xl font-bold text-ib-text">Evidence</h1>
    <div class="space-y-3">
      {rendered.map((ev) => (
        <div class="rounded-lg border-l-2 border-ib-border bg-ib-surface p-3" data-evidence-id={ev.id} data-restricted={ev.restricted} data-evidence-kind={ev.evidence_kind}>
          {ev.restricted ? (
            <p class="text-sm italic text-ib-amber">Restricted — not publicly accessible.</p>
          ) : ev.evidence_kind === "asset" && ev.media ? (
            <div class="space-y-2">
              <div class="flex items-center gap-2 text-xs text-ib-muted">
                <span class="rounded-md bg-ib-accent/15 px-1.5 py-0.5 text-ib-accent">asset</span>
                {ev.media.mime_type && <span class="font-mono">{ev.media.mime_type}</span>}
                {ev.media.width && ev.media.height && <span>{ev.media.width}×{ev.media.height}px</span>}
              </div>
              {ev.github_url && (
                <img src={ev.github_url} alt={ev.media.alt_text ?? ev.artifact_path ?? "image asset"} loading="lazy" class="max-w-full rounded-lg border border-ib-border" style="max-height: 480px; object-fit: contain;" />
              )}
              {ev.artifact_path && <p class="font-mono text-xs text-ib-muted">{ev.artifact_path}</p>}
            </div>
          ) : (
            <div class="space-y-1">
              {ev.excerpt && <p class="font-mono text-sm whitespace-pre-wrap text-ib-text">{ev.excerpt}</p>}
              {ev.locator && <p class="text-xs text-ib-muted">Locator: {JSON.stringify(ev.locator)}</p>}
            </div>
          )}
        </div>
      ))}
      {rendered.length === 0 && <p class="text-sm text-ib-muted">No evidence found for this record.</p>}
    </div>
  </div>
</Base>
