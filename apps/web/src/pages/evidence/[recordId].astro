<!--
<MODULE_CONTRACT>
<purpose>Renders a server-rendered evidence page for a specific record, showing public and restricted evidence items with locators.</purpose>
<non-goals>
  <item>Does not filter evidence by claim — direct evidence lookup by record ID only.</item>
</non-goals>
</MODULE_CONTRACT>
<CHANGE_SUMMARY>
  <item>Initial creation: evidence detail page with rendered evidence and restriction display.</item>
</CHANGE_SUMMARY>
-->
---
export const prerender = false;

import Base from "../../layouts/Base.astro";
import { createWebContext } from "../../lib/context.ts";
import { getPageMetadata } from "../../lib/metadata.ts";
import { renderEvidence } from "../../lib/evidence.ts";

const { recordId } = Astro.params;
const distDir = Astro.locals.distDir ?? "";
const ctx = await createWebContext(distDir);
const meta = getPageMetadata(ctx);

const evidence = ctx.store.evidence.filter((e) => e.source_id === recordId || e.id === recordId);
const rendered = renderEvidence(evidence, ctx.store.sources);
---

<Base title={`Evidence — ${recordId}`} metadata={meta}>
  <div class="space-y-6">
    <h1 class="text-2xl font-bold text-ib-text">Evidence</h1>
    <div class="space-y-3">
      {rendered.map((ev) => (
        <div class="rounded-lg border-l-2 border-ib-border bg-ib-surface p-3" data-evidence-id={ev.id} data-restricted={ev.restricted}>
          {ev.restricted ? (
            <p class="text-sm italic text-ib-amber">Restricted — not publicly accessible.</p>
          ) : (
            <div class="space-y-1">
              {ev.excerpt && <p class="font-mono text-sm whitespace-pre-wrap text-ib-text">{ev.excerpt}</p>}
              {ev.locator && <p class="text-xs text-ib-muted">Locator: {JSON.stringify(ev.locator)}</p>}
            </div>
          )}
        </div>
      ))}
      {rendered.length === 0 && <p class="text-sm text-ib-muted">No evidence found for this record.</p>}
    </div>
  </div>
</Base>
