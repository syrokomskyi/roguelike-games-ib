<!--
<MODULE_CONTRACT>
<purpose>Base HTML layout for all web pages — renders head metadata, navigation bar, main content slot, and footer with license notice.</purpose>
<non-goals>
  <item>Does not provide page-specific content — layout shell only.</item>
  <item>Does not enforce authority — metadata injection is opt-in.</item>
</non-goals>
</MODULE_CONTRACT>
<CHANGE_SUMMARY>
  <item>Initial creation: Base layout with nav, footer, metadata meta tags, and content slot.</item>
</CHANGE_SUMMARY>
@ai-invariant The nav links and footer license text must remain consistent across all pages — changes here affect every page.
-->
---
import { metadataToHtmlMeta, type PageMetadata } from "../lib/metadata.ts";
import "../styles/global.css";

interface Props {
  title: string;
  metadata?: PageMetadata;
}

const { title, metadata } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title} — Roguelike Inspiration Base</title>
  {metadata && <Fragment set:html={metadataToHtmlMeta(metadata)} />}
</head>
<body>
  <nav class="sticky top-0 z-50 border-b border-ib-border bg-ib-surface/95 backdrop-blur">
    <div class="mx-auto flex max-w-7xl items-center gap-6 px-4 py-3">
      <a href="/" class="flex items-center gap-2 text-lg font-bold text-ib-text hover:no-underline">
        <span class="text-ib-accent">◈</span> Roguelike IB
      </a>
      <div class="flex items-center gap-4 text-sm">
        <a href="/search" class="text-ib-muted hover:text-ib-text">Search</a>
        <a href="/games/" class="text-ib-muted hover:text-ib-text">Games</a>
        <a href="/compare/" class="text-ib-muted hover:text-ib-text">Compare</a>
        <a href="/design/" class="text-ib-muted hover:text-ib-text">Design</a>
        <a href="/dataset/" class="text-ib-muted hover:text-ib-text">Dataset</a>
        <a href="/about/method/" class="text-ib-muted hover:text-ib-text">Method</a>
      </div>
    </div>
  </nav>
  <main class="mx-auto max-w-7xl px-4 py-8">
    <slot />
  </main>
  <footer class="border-t border-ib-border py-6 text-center text-sm text-ib-muted">
    <p>Roguelike Inspiration Base — CC-BY-4.0</p>
  </footer>
</body>
</html>
