---
/*
<MODULE_CONTRACT>
<purpose>Root HTML layout for all pages — renders nav bar with active-section highlighting, GitHub link, search shortcut, footer, and slot for page content.</purpose>
<non-goals>
  <item>Does not fetch data — receives title and metadata as props.</item>
</non-goals>
</MODULE_CONTRACT>
<CHANGE_SUMMARY>
  <item>Initial creation: base layout with nav, footer, and keyboard search shortcut.</item>
  <item>Added GitHub repository link icon to nav bar.</item>
</CHANGE_SUMMARY>
*/
import { metadataToHtmlMeta } from "../lib/metadata";
import type { PageMetadata } from "../lib/metadata";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import "../styles/global.css";

interface Breadcrumb {
  label: string;
  href?: string;
}

interface Props {
  title: string;
  metadata?: PageMetadata;
  activeNav?: string;
  fullWidth?: boolean;
  world?: "canonical" | "laboratory";
  breadcrumbs?: Breadcrumb[];
}

const { title, metadata, activeNav, fullWidth = false, world = "canonical", breadcrumbs } = Astro.props;
const navItems = [
  { href: "/search", label: "Explore", key: "search" },
  { href: "/games/", label: "Games", key: "games" },
  { href: "/design/", label: "Design Space", key: "design" },
  { href: "/compare/", label: "Compare", key: "compare" },
  { href: "/inspiration", label: "Laboratory", key: "laboratory" },
];
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title} — Roguelike Inspiration Base</title>
  <meta name="theme-color" content={world === "laboratory" ? "#17151f" : "#F3F1EA"} />
  {metadata && <Fragment set:html={metadataToHtmlMeta(metadata)} />}
</head>
<body class={world === "laboratory" ? "laboratory-world" : "canonical-world"}>
  <nav class="sticky top-0 z-50 border-b border-ib-border bg-ib-bg/92 backdrop-blur-md">
    <div class="mx-auto flex min-h-16 max-w-[90rem] items-center gap-7 px-5 lg:px-8">
      <a href="/" class="mr-auto flex items-center gap-3 text-ib-text no-underline">
        <span class="grid size-8 place-items-center border border-ib-text font-mono text-sm font-semibold text-ib-accent">@</span>
        <span class="hidden leading-none sm:block"><b class="block text-sm tracking-[.12em]">RIB</b><small class="mt-1 block font-mono text-[9px] uppercase tracking-[.15em] text-ib-muted">Design Space Atlas</small></span>
      </a>
      <div class="hidden items-center gap-5 text-sm md:flex">
        {navItems.map((item) => (
          <a href={item.href} class={`relative py-5 transition-colors hover:text-ib-text hover:no-underline ${activeNav === item.key ? "text-ib-text after:absolute after:inset-x-0 after:bottom-[-1px] after:h-0.5 after:bg-ib-accent" : "text-ib-muted"}`}>{item.label}</a>
        ))}
      </div>
      <details class="relative md:hidden">
        <summary class="cursor-pointer border border-ib-border px-3 py-2 font-mono text-xs text-ib-muted marker:content-none">Map</summary>
        <div class="absolute right-0 top-[calc(100%+.75rem)] z-10 w-52 border border-ib-border bg-ib-surface p-2 shadow-[5px_5px_0_var(--color-ib-border)]">
          {navItems.map((item) => (
            <a href={item.href} class={`block px-3 py-2.5 text-sm hover:bg-ib-surface2 hover:no-underline ${activeNav === item.key ? "text-ib-accent" : "text-ib-text"}`}>{item.label}</a>
          ))}
        </div>
      </details>
      <a href="https://github.com/syrokomskyi/roguelike-games-ib" target="_blank" rel="noopener noreferrer" aria-label="GitHub repository" class="ml-1 flex items-center text-ib-muted transition-colors hover:text-ib-text hover:no-underline">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" class="size-5"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
      </a>
      <a href="/search" aria-label="Search the atlas" class="ml-1 flex items-center gap-3 border-l border-ib-border pl-5 font-mono text-xs text-ib-muted hover:text-ib-text hover:no-underline"><span>Search</span><kbd class="border border-ib-border px-1.5 py-1 text-[10px]">⌘K</kbd></a>
    </div>
  </nav>
  <main class={fullWidth ? "" : "mx-auto max-w-[90rem] px-5 py-10 lg:px-8 lg:py-14"}>
    {breadcrumbs && breadcrumbs.length > 1 && <div class="mb-7"><Breadcrumbs items={breadcrumbs} /></div>}
    <slot />
  </main>
  <footer class="border-t border-ib-border bg-ib-bg py-8">
    <div class="mx-auto flex max-w-[90rem] flex-col gap-5 px-5 sm:flex-row sm:items-end sm:justify-between lg:px-8">
      <div><p class="atlas-label text-ib-text">Roguelike Inspiration Base</p><p class="mt-2 text-sm text-ib-muted">A cartographer's instrument for unexplored design space.</p></div>
      <div class="flex items-center gap-4 text-sm">
        <a href="/about/method/" class="text-ib-muted">Method</a><a href="/dataset/" class="text-ib-muted">Dataset</a><span class="font-mono text-xs text-ib-muted">CC-BY-4.0</span>
      </div>
    </div>
  </footer>
  <script>
    document.addEventListener("keydown", (event) => {
      if (!(event.metaKey || event.ctrlKey) || event.key.toLowerCase() !== "k") return;
      event.preventDefault();

      const searchInput = document.querySelector<HTMLInputElement>('input[name="q"]');
      if (searchInput) {
        searchInput.focus();
        return;
      }

      window.location.assign("/search");
    });
  </script>
</body>
</html>
