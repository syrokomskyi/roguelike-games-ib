---
import { metadataToHtmlMeta } from "../lib/metadata";
import type { PageMetadata } from "../lib/metadata";
import "../styles/global.css";

interface Props {
  title: string;
  metadata?: PageMetadata;
  activeNav?: string;
  fullWidth?: boolean;
}

const { title, metadata, activeNav, fullWidth = false } = Astro.props;
const navItems = [
  { href: "/search", label: "Search", key: "search" },
  { href: "/ask", label: "Ask", key: "ask" },
  { href: "/inspiration", label: "Create", key: "create" },
  { href: "/games/", label: "Games", key: "games" },
  { href: "/compare/", label: "Compare", key: "compare" },
  { href: "/design/", label: "Design", key: "design" },
  { href: "/dataset/", label: "Dataset", key: "dataset" },
  { href: "/about/method/", label: "Method", key: "method" },
];
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title} — Roguelike Inspiration Base</title>
  {metadata && <Fragment set:html={metadataToHtmlMeta(metadata)} />}
</head>
<body>
  <nav class="sticky top-0 z-50 border-b border-ib-border bg-ib-surface/95 backdrop-blur">
    <div class="mx-auto flex max-w-7xl items-center gap-6 px-4 py-3">
      <a href="/" class="flex items-center gap-2 text-lg font-bold text-ib-text hover:no-underline">
        <span class="text-ib-accent">◈</span> Roguelike IB
      </a>
      <div class="flex items-center gap-4 text-sm">
        {navItems.map((item) => (
          <a href={item.href} class={`transition-colors hover:text-ib-text ${activeNav === item.key ? "text-ib-accent font-medium" : "text-ib-muted"}`}>{item.label}</a>
        ))}
      </div>
    </div>
  </nav>
  <main class={fullWidth ? "" : "mx-auto max-w-7xl px-4 py-8"}>
    <slot />
  </main>
  <footer class="border-t border-ib-border py-6">
    <div class="mx-auto flex max-w-7xl flex-col items-center gap-3 px-4 sm:flex-row sm:justify-between">
      <p class="text-sm text-ib-muted">Roguelike Inspiration Base — CC-BY-4.0</p>
      <div class="flex items-center gap-4 text-sm">
        <a href="/games/" class="text-ib-muted transition-colors hover:text-ib-text">Games</a>
        <a href="/search" class="text-ib-muted transition-colors hover:text-ib-text">Search</a>
        <a href="/compare/" class="text-ib-muted transition-colors hover:text-ib-text">Compare</a>
        <a href="/dataset/" class="text-ib-muted transition-colors hover:text-ib-text">Dataset</a>
      </div>
    </div>
  </footer>
</body>
</html>
