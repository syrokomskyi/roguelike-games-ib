# URL of the search API Cloudflare Worker. Omit only when the Worker is routed
# under the same origin as this static site.
# Production: set to the deployed Worker URL (e.g. https://roguelike-ib-search-api.workers.dev)
PUBLIC_SEARCH_API_URL=https://roguelike-ib-search-api.<account>.workers.dev

# Required by `pnpm index:embeddings`; this is the same value as the Worker secret
# INDEXING_TOKEN and must never be committed.
SEARCH_API_URL=https://roguelike-ib-search-api.<account>.workers.dev
