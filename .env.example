# Repository-wide environment configuration. Copy to .env and fill in.
# .env is gitignored; .env.example is committable.

# ── AI API keys (for AI-assisted gogols / brand-voice / etc.) ────────────────────
# Anthropic Claude API key
# Get it at: https://console.anthropic.com/settings/keys
# Used by: AI gogols across apps (Claude models)
ANTHROPIC_API_KEY=

# Google Gemini API key
# Get it at: https://makersuite.google.com/app/apikey
# Used by: AI gogols that use Gemini models
GEMINI_API_KEY=

# OpenAI API key
# Get it at: https://platform.openai.com/api-keys
# Used by: AI gogols that use GPT models, code-compass CLI
OPENAI_API_KEY=

# Perplexity API key
# Get it at: https://www.perplexity.ai/settings/api
# Used by: AI gogols that use Perplexity models (site, inticle)
PERPLEXITY_API_KEY=

# OpenRouter API key
# Get it at: https://openrouter.ai/keys
# Used by: AI gogols that use OpenRouter models
OPENROUTER_API_KEY=
